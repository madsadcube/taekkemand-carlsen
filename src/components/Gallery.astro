---
const portfolioItems = [
  {
    img: '/img/fb_straatag1.jpg',
    alt: 'Nyt stråtag på stor ejendom',
    desktopSpan: 'md:col-span-8',
    desktopHeight: 'md:h-[500px]',
    label: 'Større Ejendom · Helsinge',
    title: 'Nyt stråtag på herskabsvilla',
    titleSize: 'md:text-[1.8rem]',
    paddingClass: 'md:p-8',
  },
  {
    img: '/img/reparation3.webp',
    alt: 'Klassisk stråtag reparation',
    desktopSpan: 'md:col-span-4',
    desktopHeight: 'md:h-[500px]',
    label: 'Reparation · Hillerød',
    title: 'Klassisk stråtag',
    titleSize: 'md:text-[1.8rem]',
    paddingClass: 'md:p-8',
  },
  {
    img: '/img/fb_projekt1.jpg',
    alt: 'Stråtag projekt',
    desktopSpan: 'md:col-span-4',
    desktopHeight: 'md:h-[360px]',
    title: 'Nyt stråtag',
    titleSize: 'md:text-[1.4rem]',
    paddingClass: 'md:p-6',
  },
  {
    img: '/img/fb_projekt2.jpg',
    alt: 'Stråtag projekt',
    desktopSpan: 'md:col-span-4',
    desktopHeight: 'md:h-[360px]',
    title: 'Mønning',
    titleSize: 'md:text-[1.4rem]',
    paddingClass: 'md:p-6',
  },
  {
    img: '/img/fb_projekt3.jpg',
    alt: 'Stråtag projekt',
    desktopSpan: 'md:col-span-4',
    desktopHeight: 'md:h-[360px]',
    title: 'Renovering',
    titleSize: 'md:text-[1.4rem]',
    paddingClass: 'md:p-6',
  },
  {
    img: '/img/fb_projekt4.jpg',
    alt: 'Stråtag projekt',
    desktopSpan: 'md:col-span-4',
    desktopHeight: 'md:h-[400px]',
    title: 'Rygning',
    titleSize: 'md:text-[1.4rem]',
    paddingClass: 'md:p-6',
  },
  {
    img: '/img/fb_projekt5.jpg',
    alt: 'Stråtag projekt',
    desktopSpan: 'md:col-span-8',
    desktopHeight: 'md:h-[400px]',
    label: 'Renovering · Nordsjælland',
    title: 'Fuld tagrenovering',
    titleSize: 'md:text-[1.8rem]',
    paddingClass: 'md:p-8',
  },
]
---

<section id="billeder" class="py-24" style="background: linear-gradient(180deg, #fff 0%, rgba(235,207,162,0.50) 100%); position: relative; overflow: hidden;">
  <div class="max-w-7xl mx-auto px-8">

    <div class="flex justify-between items-end mb-16">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-secondary); font-family: var(--font-label); letter-spacing: 0.3em;">Portefølje</span>
        <h2 class="mt-4" style="font-family: var(--font-headline); font-size: clamp(2rem, 4vw, 3.2rem); color: #431a06;">
          Kvalitet i alle detaljer
        </h2>
      </div>
      <div class="hidden md:block">
        <p class="text-right max-w-xs text-sm leading-relaxed" style="color: var(--color-outline); font-family: var(--font-body);">
          Vi betjener kunder i hele Danmark med fokus på holdbarhed og æstetik.
        </p>
      </div>
    </div>

    <div class="relative">
      <div id="gallery-mobile-slider" class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2 -mx-2 px-2 md:mx-0 md:px-0 md:pb-0 md:grid md:grid-cols-12 md:gap-6 md:overflow-visible">
        {portfolioItems.map((item) => (
          <div class={`w-[86vw] max-w-[420px] shrink-0 snap-start group cursor-pointer relative overflow-hidden rounded-lg md:w-auto md:max-w-none md:shrink md:snap-none ${item.desktopSpan}`}>
            <img
              class={`w-full h-[380px] object-cover transition-transform duration-1000 group-hover:scale-105 ${item.desktopHeight}`}
              src={item.img}
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
            <div class={`hidden md:flex absolute inset-0 flex-col justify-end opacity-0 group-hover:opacity-100 transition-opacity duration-500 ${item.paddingClass}`} style="background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);">
              {item.label && (
                <span class="text-sm uppercase tracking-widest mb-2" style="color: #ffdcc1; font-family: var(--font-label);">{item.label}</span>
              )}
              <h3 class={`text-white ${item.titleSize}`} style="font-family: var(--font-headline);">{item.title}</h3>
            </div>
          </div>
        ))}
      </div>

      <div class="flex justify-center gap-3 mt-4 md:hidden">
        <button type="button" data-slider-target="gallery-mobile-slider" data-direction="prev" class="w-10 h-10 rounded-full flex items-center justify-center" style="background: #fff; border: 1px solid var(--color-outline-variant); color: #431a06;" aria-label="Forrige">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button type="button" data-slider-target="gallery-mobile-slider" data-direction="next" class="w-10 h-10 rounded-full flex items-center justify-center" style="background: #fff; border: 1px solid var(--color-outline-variant); color: #431a06;" aria-label="Næste">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const gallerySlider = document.getElementById('gallery-mobile-slider');
  const galleryButtons = document.querySelectorAll('[data-slider-target="gallery-mobile-slider"]');

  if (gallerySlider && galleryButtons.length > 0) {
    const getScrollStep = () => {
      const firstCard = gallerySlider.children[0];
      if (!firstCard) return 320;
      const styles = window.getComputedStyle(gallerySlider);
      const gap = parseFloat(styles.columnGap || styles.gap || '16');
      return firstCard.getBoundingClientRect().width + gap;
    };

    galleryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const direction = button.getAttribute('data-direction') === 'prev' ? -1 : 1;
        gallerySlider.scrollBy({ left: direction * getScrollStep(), behavior: 'smooth' });
      });
    });
  }
</script>
