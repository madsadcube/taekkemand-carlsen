---
const services = [
  {
    img: '/img/straatag1.webp',
    title: 'Nyt stråtag',
    desc: 'Komplet opsætning af nyt stråtag fra bund til top — leveret inden for 90 dage.',
  },
  {
    img: '/img/reparation3.webp',
    title: 'Reparation & renovering',
    desc: 'Punktreparationer og fuld renovering af eksisterende stråtag.',
  },
  {
    img: '/img/rygning.webp',
    title: 'Mønning & rygning',
    desc: 'Udskiftning og reparation af mønning for tæt og holdbart tag.',
  },
  {
    img: '/img/algebehandling2.webp',
    title: 'Algebehandling',
    desc: 'Effektiv behandling mod alger og mos der forlænger tagets levetid.',
  },
  {
    img: '/img/vedligehold1.webp',
    title: 'Vedligeholdelse',
    desc: 'Løbende eftersyn og vedligehold — så dit tag holder i generationer.',
  },
  {
    img: '/img/skorsten3.webp',
    title: 'Taginspektion',
    desc: 'Grundig vurdering af tagets tilstand — gratis og uforpligtende.',
  },
]
---

<section id="ydelser" class="py-24" style="background: #ffffff; position: relative; overflow: hidden;">
  <div class="max-w-7xl mx-auto px-8">

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-primary); font-family: var(--font-label); letter-spacing: 0.3em;">Vores ydelser</span>
      <h2 class="mt-4" style="font-family: var(--font-headline); font-size: clamp(2rem, 4vw, 3.2rem); color: #431a06;">
        Alt inden for tækning og tagvedligehold
      </h2>
    </div>

    <div class="relative">
      <div id="services-mobile-slider" class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2 -mx-2 px-2 sm:mx-0 sm:px-0 sm:pb-0 sm:grid sm:grid-cols-2 md:grid-cols-3 sm:gap-8 sm:overflow-visible">
        {services.map((s) => (
          <div class="w-[82vw] max-w-[360px] shrink-0 snap-start rounded-lg overflow-hidden group hover:shadow-lg transition-shadow sm:w-auto sm:max-w-none sm:shrink sm:snap-none" style="background: var(--color-surface-bright); border: 1px solid var(--color-outline-variant);">
            <div class="overflow-hidden" style="height: 200px;">
              <img
                src={s.img}
                alt={s.title}
                loading="lazy"
              decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <h3 class="mb-2" style="font-family: var(--font-headline); font-size: 1.3rem; color: #431a06;">{s.title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--color-outline); font-family: var(--font-body);">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="sm:hidden flex justify-center gap-3 mt-4">
        <button type="button" data-slider-target="services-mobile-slider" data-direction="prev" class="w-10 h-10 rounded-full flex items-center justify-center" style="background: #fff; border: 1px solid var(--color-outline-variant); color: #431a06;" aria-label="Forrige">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button type="button" data-slider-target="services-mobile-slider" data-direction="next" class="w-10 h-10 rounded-full flex items-center justify-center" style="background: #fff; border: 1px solid var(--color-outline-variant); color: #431a06;" aria-label="Næste">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <div class="text-center mt-12">
      <a
        href="#kontakt"
        class="inline-block px-8 py-4 rounded-lg font-bold transition-all hover:opacity-90"
        style="background: #ffdcc1; color: #431a06; font-family: var(--font-body);"
      >
        Få et gratis tilbud
      </a>
    </div>

  </div>
</section>

<script is:inline>
  requestAnimationFrame(() => {
    const servicesSlider = document.getElementById('services-mobile-slider');
    const servicesButtons = document.querySelectorAll('[data-slider-target="services-mobile-slider"]');

    if (servicesSlider && servicesButtons.length > 0) {
      const getScrollStep = () => {
        const firstCard = servicesSlider.children[0];
        if (!firstCard) return 280;
        const styles = window.getComputedStyle(servicesSlider);
        const gap = parseFloat(styles.columnGap || styles.gap || '16');
        return firstCard.getBoundingClientRect().width + gap;
      };

      servicesButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const direction = button.getAttribute('data-direction') === 'prev' ? -1 : 1;
          const step = getScrollStep();
          const maxScroll = servicesSlider.scrollWidth - servicesSlider.clientWidth;
          if (direction === 1 && servicesSlider.scrollLeft >= maxScroll - 4) {
            servicesSlider.scrollTo({ left: 0, behavior: 'smooth' });
          } else if (direction === -1 && servicesSlider.scrollLeft <= 4) {
            servicesSlider.scrollTo({ left: maxScroll, behavior: 'smooth' });
          } else {
            servicesSlider.scrollBy({ left: direction * step, behavior: 'smooth' });
          }
        });
      });
    }
  });
</script>
