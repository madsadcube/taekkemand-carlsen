---
const anmeldelser = [
  { citat: 'De holder hvad de lover', tekst: 'Vi har netop fået nyt stråtag på hovedhuset ved stranden samt pudset annekset af (16 år gammelt). Jeg har fulgt arbejdet på tætteste hold og kan varmt anbefale Jacob og hans team. De har været effektive og dygtige.', navn: 'Peter Sonne Christensen', ydelse: 'Nyt stråtag' },
  { citat: 'Super glade...', tekst: 'Vi har fået nyt tag og er super glade for det arbejde der er blevet lavet. Jacob og Matias er et par flinke fyre og holder hvad de lover. Vi vil helt sikkert anbefale tækkemand Carlsen.', navn: 'Christian Pfeil Bendtsen', ydelse: 'Nyt stråtag' },
  { citat: 'Fantastisk stykke arbejde', tekst: 'Jakob har lavet et fantastisk stykke arbejde. Han er omhyggelig og man mærker at hans faglige stolthed betyder alt for ham. Meget regulær og til at stole på.', navn: 'Børge Jensen', ydelse: 'Mønning' },
  { citat: 'Kan varmt anbefales...', tekst: 'Vi har fået nyt stråtag på vores gamle stuehus. Begge utrolig kompetente, samvittighedsfulde og dygtige til deres håndværk.', navn: 'Anne-mette Bøtting Bendtsen', ydelse: 'Nyt stråtag' },
  { citat: 'Dedikerede tækkemænd', tekst: 'Samarbejdet med Jacob har været helt igennem positivt og fleksibelt, også selv om opgaven blev løst hen over en vinter med frost og sne.', navn: 'Thomas Brandt', ydelse: 'Nyt stråtag' },
  { citat: 'Flot resultat', tekst: 'Vi er så glade for det fantastiske arbejde Jacob har udført.', navn: 'Vivi Stenberg', ydelse: 'Reparation af stråtag' },
  { citat: 'Overskueligt tilbud', tekst: 'Tilbuddet var gennemskueligt og detaljeret. Arbejdet blev udført som aftalt, og vi blev løbende informeret undervejs. Det færdige resultat er virkelig flot.', navn: 'Kasper Andreasen', ydelse: 'Renovering af stråtag' },
]

const stars = [1,2,3,4,5]
---

<section id="anmeldelser" class="py-24" style="background: #ffffff; position: relative; overflow: hidden;">
  <div aria-hidden="true" class="grain-left"></div>
  <div class="max-w-7xl mx-auto px-8">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-primary); font-family: var(--font-label); letter-spacing: 0.3em;">Anmeldelser</span>
        <h2 class="mt-3" style="font-family: var(--font-headline); font-size: clamp(2rem, 4vw, 3.2rem); color: #431a06;">Vi samler på glade kunder</h2>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <svg class="w-7 h-7" viewBox="0 0 24 24">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <div>
          <div class="flex items-center gap-1.5">
            <div class="flex gap-0.5">
              {stars.map(() => (
                <svg class="w-4 h-4" fill="#b8960c" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <span class="font-bold text-sm" style="color: #431a06; font-family: var(--font-body);">5,0</span>
          </div>
          <p class="text-xs" style="color: var(--color-outline); font-family: var(--font-body);">Google Anmeldelser</p>
        </div>
      </div>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {anmeldelser.map((a) => (
        <div class="rounded-xl p-8 flex flex-col gap-4" style="background: white; border: 1px solid var(--color-outline-variant);">
          <!-- Stars -->
          <div class="flex gap-0.5">
            {stars.map(() => (
              <svg class="w-4 h-4" fill="#b8960c" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <!-- Quote -->
          <p class="font-bold" style="font-family: var(--font-headline); font-style: italic; font-size: 1.05rem; color: #431a06;">"{a.citat}"</p>
          <!-- Text -->
          <p class="text-sm leading-relaxed flex-1" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">{a.tekst}</p>
          <!-- Author -->
          <div style="border-top: 1px solid var(--color-outline-variant); padding-top: 1rem;">
            <p class="font-bold text-sm" style="color: #431a06; font-family: var(--font-body);">{a.navn}</p>
            <p class="text-xs mt-0.5" style="color: var(--color-outline); font-family: var(--font-body);">{a.ydelse}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
