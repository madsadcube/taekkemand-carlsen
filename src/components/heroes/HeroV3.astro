---
// Variant 3: Centered ceremoniel — centreret tekst, smal kolonne, premium feel
---

<section class="hero-v3 relative flex items-center justify-center text-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <picture>
      <source srcset="/img/straatag1-hero.webp" type="image/webp" />
      <img class="w-full h-full object-cover" style="object-position: 50% 35%;"
        src="/img/straatag1-hero.jpg" alt="Stråtag af Tækkemand Carlsen"
        fetchpriority="high" loading="eager" width="1920" height="1080" />
    </picture>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, rgba(15,10,4,0.55) 0%, rgba(15,10,4,0.85) 100%);"></div>
  </div>

  <div class="hero-v3-content relative z-10 max-w-3xl mx-auto px-8 w-full">
    <div class="flex items-center justify-center gap-3 mb-8">
      <span class="block h-px w-12" style="background: rgba(255,220,193,0.6);"></span>
      <span class="text-xs font-bold uppercase tracking-[0.4em]" style="color: #ffdcc1; font-family: var(--font-label);">
        Tækkemand siden 1972
      </span>
      <span class="block h-px w-12" style="background: rgba(255,220,193,0.6);"></span>
    </div>

    <h1 class="hero-v3-h1 leading-[1.02] mb-8" style="font-family: var(--font-headline); color: #fff;">
      Stråtag der holder<br/>
      <span class="italic" style="color:#ffdcc1">i generationer</span>
    </h1>

    <p class="hero-v3-sub mx-auto mb-12 leading-relaxed" style="color: rgba(251,249,248,0.9); font-family: var(--font-body); max-width: 540px;">
      Over 50 års erfaring bag hvert tag. Professionelt håndværk — udført rigtigt, første gang.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
      <a href="#kontakt" class="px-10 py-4 rounded-lg font-bold text-lg transition-transform hover:scale-105"
        style="background: #6f4315; color: #fff; font-family: var(--font-body);">
        Få et uforpligtende tilbud
      </a>
      <a href="tel:+4524248080" class="flex items-center gap-2 font-bold text-lg" style="color: #fff; font-family: var(--font-body);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        24 24 80 80
      </a>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm" style="color: #ffdcc1; font-family: var(--font-body);">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Levering inden 90 dage
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        50+ års erfaring
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Skriftlig garanti
      </span>
    </div>
  </div>
</section>

<style>
  .hero-v3 { height: 100svh; min-height: 640px; max-height: 880px; }
  .hero-v3-content { padding-top: 100px; padding-bottom: 56px; }
  .hero-v3-h1 { font-size: clamp(2.5rem, 8vw, 3.5rem); }
  .hero-v3-sub { font-size: clamp(1rem, 1.4vw, 1.2rem); }
  @media (min-width: 768px) {
    .hero-v3 { min-height: 700px; max-height: 820px; }
    .hero-v3-content { padding-top: 120px; padding-bottom: 72px; }
    .hero-v3-h1 { font-size: clamp(3.5rem, 6vw, 5rem); }
  }
</style>
</content>
</invoke>