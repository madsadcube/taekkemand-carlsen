---
// Variant 8: Photo journal — diagonal split med tre billeder forskudt,
// håndskrift-agtig italic, dagbogs-tone. Personligt og varmt.
---

<section class="hero-v8">
  <div class="v8-bg-pattern"></div>

  <div class="v8-container">
    <!-- Left: copy -->
    <div class="v8-copy">
      <div class="v8-stamp">
        <div class="v8-stamp-line">EST.</div>
        <div class="v8-stamp-year">1972</div>
      </div>

      <span class="v8-eyebrow">Fra vores værksted i Helsinge</span>

      <h1 class="v8-h1">
        Hvert stråtag er <em>en historie</em><br/>
        <span class="v8-h1-second">vi pakker ind <em>i tag.</em></span>
      </h1>

      <p class="v8-body">
        I tre generationer har Carlsen-familien lagt stråtag på Sjælland. Vi kender hver gård,
        hver tag-stol og hver kunde ved navn. <em>Det er sådan, et tag bliver til hjem.</em>
      </p>

      <div class="v8-signature">
        <svg viewBox="0 0 220 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMinYMid">
          <path d="M5 40 Q 20 10, 35 35 T 65 35 Q 75 20, 85 40 Q 95 55, 110 30 T 145 30 Q 155 15, 165 35 Q 175 50, 195 25 T 215 30"
            stroke="#1b1c1c" stroke-width="2" stroke-linecap="round" fill="none"/>
        </svg>
        <div class="v8-sign-name">— Jakob Carlsen, tækkemand</div>
      </div>

      <div class="v8-cta">
        <a href="#kontakt" class="v8-btn">
          Skriv til Jakob
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="tel:+4524248080" class="v8-call">
          eller ring direkte:<br/>
          <strong>24 24 80 80</strong>
        </a>
      </div>
    </div>

    <!-- Right: photo collage -->
    <div class="v8-photos">
      <figure class="v8-photo v8-p1">
        <img src="/img/straatag1-hero.jpg" alt="Stråtag" loading="eager" fetchpriority="high"/>
        <figcaption class="v8-cap">№01 / Færdiglagt tag, Tisvilde</figcaption>
      </figure>
      <figure class="v8-photo v8-p2">
        <img src="/img/jakob.jpg" alt="Jakob Carlsen i arbejde" loading="lazy"/>
        <figcaption class="v8-cap v8-cap-rotate">№02 / Jakob, foråret '24</figcaption>
      </figure>
      <figure class="v8-photo v8-p3">
        <img src="/img/rep_straatag4.jpeg" alt="Mønning" loading="lazy"/>
        <figcaption class="v8-cap">№03 / Mønning</figcaption>
      </figure>

      <!-- Tape elements -->
      <span class="v8-tape v8-tape-1"></span>
      <span class="v8-tape v8-tape-2"></span>
    </div>
  </div>
</section>

<style>
  .hero-v8 {
    background: #f4ede2;
    color: #1b1c1c;
    min-height: 100svh;
    padding-top: 96px;
    position: relative;
    overflow: hidden;
  }
  .v8-bg-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    background-image:
      radial-gradient(circle at 12% 22%, rgba(111,67,21,0.05) 0%, transparent 30%),
      radial-gradient(circle at 88% 78%, rgba(111,67,21,0.05) 0%, transparent 35%);
  }

  .v8-container {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 24px 80px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .v8-copy { position: relative; padding-top: 24px; }

  .v8-stamp {
    position: absolute;
    top: 0;
    right: 0;
    width: 100px;
    height: 100px;
    border: 2px solid #6f4315;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #6f4315;
    font-family: var(--font-label);
    transform: rotate(-8deg);
    opacity: 0.85;
  }
  .v8-stamp-line { font-size: 10px; letter-spacing: 0.25em; }
  .v8-stamp-year { font-family: var(--font-headline); font-size: 1.75rem; font-style: italic; line-height: 1; }

  .v8-eyebrow {
    font-family: var(--font-headline);
    font-style: italic;
    font-size: 1.1rem;
    color: #6f4315;
    display: block;
    margin-bottom: 24px;
  }
  .v8-h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 1.05;
    margin: 0 0 24px;
    color: #1b1c1c;
    font-weight: 500;
  }
  .v8-h1 em { font-style: italic; color: #6f4315; font-weight: 400; }
  .v8-h1-second { display: inline-block; padding-left: clamp(1rem, 4vw, 3rem); }

  .v8-body {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: #51443a;
    max-width: 480px;
    margin: 0 0 32px;
  }
  .v8-body em { color: #1b1c1c; font-style: italic; font-family: var(--font-headline); font-size: 1.15rem; }

  .v8-signature {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px dashed rgba(111,67,21,0.3);
  }
  .v8-signature svg { width: 180px; height: auto; margin-bottom: 4px; }
  .v8-sign-name { font-family: var(--font-body); font-style: italic; font-size: 0.9rem; color: #51443a; }

  .v8-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .v8-btn {
    display: inline-flex; align-items: center; gap: 12px;
    background: #1b1c1c; color: #fff;
    padding: 16px 28px;
    font-family: var(--font-body); font-weight: 700;
    border-radius: 999px;
    transition: transform 0.3s;
  }
  .v8-btn:hover { transform: translateY(-2px); }
  .v8-call { font-family: var(--font-body); font-size: 0.85rem; color: #51443a; line-height: 1.4; }
  .v8-call strong { color: #1b1c1c; font-size: 1.15rem; }

  .v8-photos {
    position: relative;
    min-height: 460px;
  }
  .v8-photo {
    position: absolute;
    background: #fff;
    padding: 12px 12px 32px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.18);
    margin: 0;
  }
  .v8-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .v8-cap {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.78rem;
    color: #51443a;
    text-align: center;
    padding-top: 8px;
  }
  .v8-cap-rotate { transform: none; }

  .v8-p1 {
    width: 70%;
    aspect-ratio: 4/3;
    top: 0;
    right: 0;
    transform: rotate(2.5deg);
    z-index: 1;
  }
  .v8-p2 {
    width: 45%;
    aspect-ratio: 3/4;
    bottom: 8%;
    left: 0;
    transform: rotate(-4deg);
    z-index: 2;
  }
  .v8-p3 {
    width: 38%;
    aspect-ratio: 1;
    bottom: 0;
    right: 12%;
    transform: rotate(5deg);
    z-index: 3;
  }
  .v8-photo img { aspect-ratio: inherit; }

  .v8-tape {
    position: absolute;
    width: 80px;
    height: 22px;
    background: rgba(255,220,193,0.7);
    backdrop-filter: blur(2px);
    z-index: 10;
  }
  .v8-tape-1 { top: -6px; left: 32%; transform: rotate(-12deg); }
  .v8-tape-2 { bottom: 22%; right: 38%; transform: rotate(8deg); width: 60px; }

  @media (min-width: 1024px) {
    .v8-container { grid-template-columns: 5fr 6fr; gap: 80px; padding: 48px 56px 96px; }
    .v8-photos { min-height: 600px; }
  }
</style>
</content>
</invoke>