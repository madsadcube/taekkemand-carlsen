---
// Variant 1: Cinematisk — fuld-bleed billede, mørk gradient, italic serif
---

<section class="hero-v1 relative flex items-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <picture>
      <source srcset="/img/straatag1-hero.webp" type="image/webp" />
      <img class="w-full h-full object-cover" style="object-position: 50% center;"
        src="/img/straatag1-hero.jpg" alt="Stråtag af Tækkemand Carlsen"
        fetchpriority="high" loading="eager" width="1920" height="1080" />
    </picture>
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(15,10,4,0.82) 0%, rgba(15,10,4,0.60) 50%, rgba(15,10,4,0.20) 100%);"></div>
  </div>

  <div class="hero-v1-content relative z-10 max-w-7xl mx-auto px-8 w-full">
    <div class="hero-v1-text">
      <h1 class="hero-v1-h1 leading-tight mb-8" style="font-family: var(--font-headline); color: #fff;">
        Stråtag der holder <span class="italic" style="color:#ffdcc1">i generationer</span>
      </h1>
      <p class="mb-10 leading-relaxed" style="color: rgba(251,249,248,0.9); font-family: var(--font-body); font-size: clamp(1rem, 1.5vw, 1.2rem); max-width: 480px;">
        Over 50 års erfaring bag hvert tag. Professionelt håndværk — udført rigtigt, første gang.
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-4 mb-6">
        <a href="#kontakt" class="px-8 py-4 rounded-lg font-bold text-lg transition-transform hover:scale-105"
          style="background: #6f4315; color: #fff; font-family: var(--font-body);">
          Få et uforpligtende tilbud
        </a>
        <a href="tel:+4524248080" class="flex items-center gap-2 font-bold text-lg" style="color: #fff; font-family: var(--font-body);">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          24 24 80 80
        </a>
      </div>
      <span class="flex items-center gap-2 text-sm" style="color: #ffdcc1; font-family: var(--font-body);">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        Levering inden 90 dage — garanteret
      </span>
    </div>
  </div>
</section>

<style>
  .hero-v1 { height: 100svh; min-height: 620px; max-height: 880px; }
  .hero-v1-content { padding-top: 120px; padding-bottom: 56px; }
  .hero-v1-text { max-width: 560px; }
  .hero-v1-h1 { font-size: clamp(2.25rem, 8vw, 3.25rem); }
  @media (min-width: 768px) {
    .hero-v1 { min-height: 660px; max-height: 820px; }
    .hero-v1-content { padding-top: 140px; padding-bottom: 72px; }
    .hero-v1-text { max-width: 640px; }
    .hero-v1-h1 { font-size: clamp(2.75rem, 5vw, 4rem); }
  }
  @media (min-width: 1280px) {
    .hero-v1-text { max-width: 720px; }
    .hero-v1-h1 { font-size: clamp(3.25rem, 4.5vw, 4.5rem); }
  }
</style>
</content>
</invoke>