---
// Variant 5: Trust-first — anmeldelser øverst, kompakt headline, tre tillidssøjler
---

<section class="hero-v5 relative flex items-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <picture>
      <source srcset="/img/straatag1-hero.webp" type="image/webp" />
      <img class="w-full h-full object-cover" style="object-position: 60% center;"
        src="/img/straatag1-hero.jpg" alt="Stråtag af Tækkemand Carlsen"
        fetchpriority="high" loading="eager" width="1920" height="1080" />
    </picture>
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(251,249,248,0.97) 0%, rgba(251,249,248,0.92) 50%, rgba(251,249,248,0.45) 100%);"></div>
  </div>

  <div class="hero-v5-content relative z-10 max-w-7xl mx-auto px-8 w-full">
    <div class="hero-v5-text">
      <!-- Rating -->
      <div class="flex items-center gap-3 mb-8">
        <div class="flex" style="color: #d4a017;">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        </div>
        <span class="text-sm font-bold" style="color: #1b1c1c; font-family: var(--font-body);">4.9 / 5</span>
        <span class="text-sm" style="color: #51443a; font-family: var(--font-body);">— anbefalet af 200+ kunder på Sjælland</span>
      </div>

      <h1 class="hero-v5-h1 leading-[1.05] mb-6" style="font-family: var(--font-headline); color: #1b1c1c;">
        Nyt stråtag i Nordsjælland — <span class="italic" style="color:#6f4315">leveret på 90 dage</span>
      </h1>

      <p class="mb-10 leading-relaxed text-lg" style="color: #51443a; font-family: var(--font-body); max-width: 580px;">
        Få et fastpris-tilbud uden bindinger. Specialister i nyt stråtag, mønning og reparation siden 1972.
      </p>

      <!-- Three pillars -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10" style="max-width: 720px;">
        <div class="flex items-start gap-3 p-4 rounded-lg" style="background: rgba(255,255,255,0.7); border: 1px solid rgba(111,67,21,0.15);">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center" style="background: #6f4315;">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <div class="font-bold text-sm" style="color: #1b1c1c;">Fastpris</div>
            <div class="text-xs" style="color: #51443a;">Ingen ekstra-regninger</div>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-lg" style="background: rgba(255,255,255,0.7); border: 1px solid rgba(111,67,21,0.15);">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center" style="background: #6f4315;">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <div class="font-bold text-sm" style="color: #1b1c1c;">90 dage</div>
            <div class="text-xs" style="color: #51443a;">Garanteret levering</div>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-lg" style="background: rgba(255,255,255,0.7); border: 1px solid rgba(111,67,21,0.15);">
          <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center" style="background: #6f4315;">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <div class="font-bold text-sm" style="color: #1b1c1c;">50+ år</div>
            <div class="text-xs" style="color: #51443a;">Specialiseret erfaring</div>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <a href="#kontakt" class="px-8 py-4 rounded-lg font-bold text-lg transition-transform hover:scale-105"
          style="background: #6f4315; color: #fff; font-family: var(--font-body);">
          Få fastpris på dit projekt
        </a>
        <a href="tel:+4524248080" class="flex items-center gap-2 font-bold text-lg" style="color: #1b1c1c; font-family: var(--font-body);">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Ring: 24 24 80 80
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-v5 { min-height: 100svh; }
  .hero-v5-content { padding-top: 130px; padding-bottom: 80px; }
  .hero-v5-text { max-width: 760px; }
  .hero-v5-h1 { font-size: clamp(2.25rem, 7vw, 3rem); }
  @media (min-width: 768px) {
    .hero-v5 { min-height: 760px; max-height: 920px; }
    .hero-v5-content { padding-top: 150px; padding-bottom: 96px; }
    .hero-v5-h1 { font-size: clamp(2.75rem, 4.5vw, 4rem); }
  }
</style>
</content>
</invoke>