---
// Variant 4: Magazine cover — billede fylder, headline overlapper bunden, stats-bar nederst
---

<section class="hero-v4 relative overflow-hidden" style="background: #1b1c1c;">
  <div class="absolute inset-0 z-0">
    <picture>
      <source srcset="/img/straatag1-hero.webp" type="image/webp" />
      <img class="w-full h-full object-cover" style="object-position: 50% center;"
        src="/img/straatag1-hero.jpg" alt="Stråtag af Tækkemand Carlsen"
        fetchpriority="high" loading="eager" width="1920" height="1080" />
    </picture>
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(15,10,4,0.10) 0%, rgba(15,10,4,0.10) 40%, rgba(15,10,4,0.95) 100%);"></div>
  </div>

  <div class="hero-v4-content relative z-10 h-full flex flex-col">
    <div class="flex-1"></div>

    <div class="max-w-7xl mx-auto px-8 w-full">
      <span class="hero-v4-eyebrow block text-xs font-bold uppercase tracking-[0.4em] mb-6" style="color: #ffdcc1; font-family: var(--font-label);">
        Nordsjælland · Stråtag · Tagdækning
      </span>
      <h1 class="hero-v4-h1 leading-[0.95] mb-8" style="font-family: var(--font-headline); color: #fff;">
        Stråtag der holder<br/>
        <span class="italic" style="color:#ffdcc1">i generationer.</span>
      </h1>
      <p class="hero-v4-sub mb-12" style="color: rgba(251,249,248,0.85); font-family: var(--font-body); max-width: 600px;">
        Over 50 års erfaring. Professionelt håndværk — udført rigtigt, første gang.
      </p>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
        <a href="#kontakt" class="px-10 py-4 rounded-lg font-bold text-lg transition-transform hover:scale-105"
          style="background: #ffdcc1; color: #1b1c1c; font-family: var(--font-body);">
          Få et uforpligtende tilbud →
        </a>
        <a href="tel:+4524248080" class="flex items-center gap-2 font-bold text-lg" style="color: #fff; font-family: var(--font-body);">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          24 24 80 80
        </a>
      </div>
    </div>

    <div class="hero-v4-stats mt-12 py-6" style="border-top: 1px solid rgba(255,220,193,0.2); background: rgba(15,10,4,0.4); backdrop-filter: blur(6px);">
      <div class="max-w-7xl mx-auto px-8 grid grid-cols-2 md:grid-cols-4 gap-6 text-center md:text-left">
        <div>
          <div class="text-2xl md:text-3xl font-bold" style="font-family: var(--font-headline); color: #ffdcc1;">50+ år</div>
          <div class="text-xs uppercase tracking-widest mt-1" style="color: rgba(255,255,255,0.7); font-family: var(--font-label);">Specialiseret erfaring</div>
        </div>
        <div>
          <div class="text-2xl md:text-3xl font-bold" style="font-family: var(--font-headline); color: #ffdcc1;">5.000 m²</div>
          <div class="text-xs uppercase tracking-widest mt-1" style="color: rgba(255,255,255,0.7); font-family: var(--font-label);">Nordens største tækkeprojekt</div>
        </div>
        <div>
          <div class="text-2xl md:text-3xl font-bold" style="font-family: var(--font-headline); color: #ffdcc1;">90 dage</div>
          <div class="text-xs uppercase tracking-widest mt-1" style="color: rgba(255,255,255,0.7); font-family: var(--font-label);">Garanteret levering</div>
        </div>
        <div>
          <div class="text-2xl md:text-3xl font-bold" style="font-family: var(--font-headline); color: #ffdcc1;">★ 4.9</div>
          <div class="text-xs uppercase tracking-widest mt-1" style="color: rgba(255,255,255,0.7); font-family: var(--font-label);">Tilfredse kunder</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-v4 { height: 100svh; min-height: 720px; max-height: 920px; }
  .hero-v4-content { padding-top: 120px; height: 100%; }
  .hero-v4-h1 { font-size: clamp(2.5rem, 9vw, 3.75rem); }
  .hero-v4-sub { font-size: clamp(1rem, 1.4vw, 1.2rem); }
  @media (min-width: 768px) {
    .hero-v4 { min-height: 760px; max-height: 880px; }
    .hero-v4-content { padding-top: 140px; }
    .hero-v4-h1 { font-size: clamp(4rem, 7vw, 6rem); }
  }
</style>
</content>
</invoke>