---
---

<section id="kontakt" class="py-20 bg-dark text-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <!-- Left: info -->
      <div>
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Kontakt os hvis du skal bruge en tækkemand
        </h2>
        <p class="text-gray-300 text-lg mb-8">
          Uanset om du har brug for en tækker, der kan forlænge dit stråtags levetid, eller du har brug for en af vores andre serviceydelser, er du altid velkommen til at kontakte os.
        </p>

        <div class="space-y-5">
          <a href="tel:+4589883453" class="flex items-center gap-4 group">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <div class="text-sm text-gray-400">Telefon (7 dage)</div>
              <div class="text-xl font-bold group-hover:text-primary transition-colors">89 88 34 53</div>
            </div>
          </a>

          <a href="mailto:post@taekkemandcarlsen.dk" class="flex items-center gap-4 group">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <div class="text-sm text-gray-400">Email</div>
              <div class="text-lg font-semibold group-hover:text-primary transition-colors">post@taekkemandcarlsen.dk</div>
            </div>
          </a>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <div class="text-sm text-gray-400">Adresse</div>
              <div class="font-semibold">Nørretorv 30, 4100 Ringsted</div>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <div class="text-sm text-gray-400">Åbningstider</div>
              <div class="font-semibold">Man–Fre: 08:00–18:00</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: form -->
      <div class="bg-white text-dark rounded-xl p-8 shadow-2xl">
        <h3 class="text-2xl font-bold mb-6">Send en forespørgsel</h3>
        <form action="https://taekkemandcarlsen.dk/form_handler.php" method="POST" class="space-y-4">
          <!-- Honeypot -->
          <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="navn" class="block text-sm font-semibold text-gray-700 mb-1">Navn <span class="text-red-500">*</span></label>
              <input id="navn" type="text" name="navn" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
            </div>
            <div>
              <label for="telefon" class="block text-sm font-semibold text-gray-700 mb-1">Telefon <span class="text-red-500">*</span></label>
              <input id="telefon" type="tel" name="telefon" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-1">Email <span class="text-red-500">*</span></label>
            <input id="email" type="email" name="email" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="postnr" class="block text-sm font-semibold text-gray-700 mb-1">Postnr.</label>
              <input id="postnr" type="text" name="postnr" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
            </div>
            <div>
              <label for="by" class="block text-sm font-semibold text-gray-700 mb-1">By <span class="text-red-500">*</span></label>
              <input id="by" type="text" name="by" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Arbejdsområde</label>
            <div class="grid grid-cols-2 gap-2">
              {['Nyt stråtag','Renovering af stråtag','Skade/rep. af stråtag','Mønning/Rygning','Tagrender','Solceller','Skorsten','Andet'].map((item) => (
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                  <input type="checkbox" name="arbejde[]" value={item} class="accent-primary w-4 h-4" />
                  {item}
                </label>
              ))}
            </div>
          </div>

          <div>
            <label for="tidsramme" class="block text-sm font-semibold text-gray-700 mb-1">Tidsramme</label>
            <select id="tidsramme" name="tidsramme" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
              <option value="">Vælg tidsramme</option>
              <option>Indenfor 1 mdr.</option>
              <option>Indenfor 1-2 mdr.</option>
              <option>Indenfor 2-4 mdr.</option>
            </select>
          </div>

          <div>
            <label for="besked" class="block text-sm font-semibold text-gray-700 mb-1">Besked <span class="text-red-500">*</span></label>
            <textarea id="besked" name="besked" rows="3" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent resize-none"></textarea>
          </div>

          <button type="submit" class="w-full btn-primary text-center py-4 text-lg font-bold">
            Send forespørgsel
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
