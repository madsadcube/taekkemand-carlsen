---
const formspreeEndpoint = 'https://formspree.io/f/mzdkjneg';
---

<section
  id="kontakt"
  class="py-24 relative overflow-hidden"
  style="background: linear-gradient(180deg, rgba(235,207,162,0.3) 0%, #fbf9f8 100%);"
  data-offer-form
  data-cloudinary-cloud-name={import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME}
  data-cloudinary-upload-preset={import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET}
  data-formspree-endpoint={formspreeEndpoint}
>
  <div class="relative z-10 max-w-lg mx-auto px-6">

    <div class="text-center mb-8">
      <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-primary); font-family: var(--font-label); letter-spacing: 0.3em;">Kontakt os</span>
      <h2 class="mt-3 leading-tight" style="font-family: var(--font-headline); font-size: clamp(2rem, 4vw, 2.8rem); color: #431a06;">
        Få et uforpligtende tilbud
      </h2>
      <p class="mt-2 text-sm" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
        Fortæl os hvad du har brug for — vi vender tilbage med et gennemsigtigt tilbud
      </p>
    </div>

    <div class="rounded-2xl p-8" style="background: #fff; border: 1px solid var(--color-outline-variant);">
      <div class="flex items-center justify-center gap-2 mb-8">
        <div id="step1-dot" class="w-8 h-8 rounded-full text-white text-sm font-bold flex items-center justify-center" style="background: var(--color-primary); font-family: var(--font-label);">1</div>
        <div class="h-px w-16" style="background: var(--color-outline-variant);"></div>
        <div id="step2-dot" class="w-8 h-8 rounded-full text-sm font-bold flex items-center justify-center" style="background: var(--color-surface-container); color: var(--color-outline); font-family: var(--font-label);">2</div>
      </div>

      <form id="offer-form" method="POST" enctype="multipart/form-data">
        <div id="step1">
          <h3 class="font-bold text-center mb-1" style="font-family: var(--font-headline); font-size: 1.4rem; color: #431a06;">
            Hvad drejer det sig om?
          </h3>
          <p class="text-center text-sm mb-6" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
            Fortæl os hvad du har brug for hjælp til
          </p>
          <hr style="border-color: var(--color-outline-variant);" class="mb-6" />

          <div class="space-y-5">
            <div>
              <label for="service" class="block text-sm font-semibold mb-1" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                Hvad skal du have lavet? <span style="color: #c0392b;">*</span>
              </label>
              <select
                id="service"
                name="service"
                required
                class="w-full rounded-lg px-3 py-2.5 text-sm focus:outline-none"
                style="border: 1px solid var(--color-outline-variant); color: var(--color-on-background); font-family: var(--font-body); background: #fff;"
              >
                <option value="">Vælg venligst</option>
                <option>Nyt stråtag</option>
                <option>Reparation af stråtag</option>
                <option>Mønning / rygning</option>
                <option>Renovering af stråtag</option>
                <option>Alge- og mosafrensning</option>
                <option>Vurderingsrapport ifbm. huskøb eller salg</option>
                <option>Andet</option>
              </select>
              <p id="service-error" class="text-xs mt-1 hidden" style="color: #c0392b; font-family: var(--font-body);">Vælg venligst en opgave</p>
            </div>

            <div>
              <label for="timeline" class="block text-sm font-semibold mb-1" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                Hvornår skal opgaven udføres? <span style="color: #c0392b;">*</span>
              </label>
              <select
                id="timeline"
                name="timeline"
                required
                class="w-full rounded-lg px-3 py-2.5 text-sm focus:outline-none"
                style="border: 1px solid var(--color-outline-variant); color: var(--color-on-background); font-family: var(--font-body); background: #fff;"
              >
                <option value="">Vælg venligst</option>
                <option>Det haster - der er skade eller akut behov</option>
                <option>Inden for 1 måned</option>
                <option>Inden for 1-3 måneder</option>
                <option>Inden for 3-6 måneder</option>
                <option>Jeg indhenter blot tilbud</option>
              </select>
              <p id="timeline-error" class="text-xs mt-1 hidden" style="color: #c0392b; font-family: var(--font-body);">Vælg venligst hvornår opgaven skal udføres</p>
            </div>

            <div>
              <label for="besked" class="block text-sm font-semibold mb-1" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                Evt. besked
              </label>
              <textarea
                id="besked"
                name="besked"
                rows="3"
                class="w-full rounded-lg px-3 py-2.5 text-sm focus:outline-none"
                style="border: 1px solid var(--color-outline-variant); color: var(--color-on-background); font-family: var(--font-body); resize: vertical;"
                placeholder="Beskriv kort din opgave..."
              ></textarea>
            </div>

            <div>
              <label for="billeder" class="block text-sm font-semibold mb-1" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                Upload billeder af din opgave
              </label>
              <input
                type="file"
                id="billeder"
                name="billeder[]"
                accept="image/*"
                multiple
                class="w-full text-sm"
                style="color: var(--color-on-surface-variant); font-family: var(--font-body);"
              />
              <p class="text-xs mt-1" style="color: var(--color-outline); font-family: var(--font-body);">Maks. filstørrelse: 5 MB.</p>
              <p class="text-xs mt-1" style="color: var(--color-outline); font-family: var(--font-body);">Du kan uploade op til 5 billeder ad gangen.</p>
              <p id="files-error" class="text-xs mt-1 hidden" style="color: #c0392b; font-family: var(--font-body);">Du kan kun vælge op til 5 billeder.</p>
              <div id="selected-files-wrapper" class="mt-3 hidden">
                <p class="text-xs font-semibold mb-2" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">Valgte filer</p>
                <ul id="selected-files-list" class="space-y-2"></ul>
              </div>
            </div>

            <button
              type="button"
              id="to-step2"
              class="w-full py-3 px-6 rounded-lg font-bold text-base transition-opacity hover:opacity-90"
              style="background: var(--color-primary); color: #fff; font-family: var(--font-body);"
            >
              Hent tilbud
            </button>
          </div>
        </div>

        <div id="step2" class="hidden">
          <h3 class="font-bold text-center mb-1" style="font-family: var(--font-headline); font-size: 1.4rem; color: #431a06;">
            Hvordan kan vi kontakte dig?
          </h3>
          <p class="text-center text-sm mb-6" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
            Vi vender tilbage hurtigst muligt med et gennemsigtigt tilbud
          </p>
          <hr style="border-color: var(--color-outline-variant);" class="mb-6" />

          <div class="space-y-5">
            <div>
              <label for="navn" class="block text-sm font-semibold mb-1" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                Fulde navn <span style="color: #c0392b;">*</span>
              </label>
              <input
                type="text"
                id="navn"
                name="navn"
                required
                placeholder="Indtast dit fulde navn"
                class="w-full rounded-lg px-3 py-2.5 text-sm focus:outline-none"
                style="border: 1px solid var(--color-outline-variant); color: var(--color-on-background); font-family: var(--font-body);"
              />
            </div>

            <div>
              <label for="adresse" class="block text-sm font-semibold mb-1" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                Adresse <span style="color: #c0392b;">*</span>
              </label>
              <div class="autocomplete-container">
                <input
                  type="text"
                  id="adresse"
                  name="adresse"
                  required
                  placeholder="Indtast din adresse"
                  class="w-full rounded-lg px-3 py-2.5 text-sm focus:outline-none"
                  style="border: 1px solid var(--color-outline-variant); color: var(--color-on-background); font-family: var(--font-body);"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold mb-1" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                Email <span style="color: #c0392b;">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="Indtast din email"
                class="w-full rounded-lg px-3 py-2.5 text-sm focus:outline-none"
                style="border: 1px solid var(--color-outline-variant); color: var(--color-on-background); font-family: var(--font-body);"
              />
            </div>

            <div>
              <label for="telefon" class="block text-sm font-semibold mb-1" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
                Telefonnummer <span style="color: #c0392b;">*</span>
              </label>
              <div class="flex rounded-lg overflow-hidden" style="border: 1px solid var(--color-outline-variant);">
                <span class="flex items-center px-3 text-sm" style="background: var(--color-surface-container-low); border-right: 1px solid var(--color-outline-variant); color: var(--color-on-surface-variant); font-family: var(--font-body);">
                  DK +45
                </span>
                <input
                  type="tel"
                  id="telefon"
                  name="telefon"
                  required
                  inputmode="numeric"
                  pattern="[0-9]*"
                  maxlength="8"
                  placeholder="Indtast dit telefonnummer"
                  class="flex-1 px-3 py-2.5 text-sm focus:outline-none"
                  style="color: var(--color-on-background); font-family: var(--font-body);"
                />
              </div>
            </div>

            <div class="flex gap-3 pt-2">
              <button
                type="button"
                id="to-step1"
                class="flex-1 py-3 px-4 rounded-lg font-bold text-base transition-opacity hover:opacity-80"
                style="background: var(--color-surface-container-high); color: var(--color-on-surface-variant); font-family: var(--font-body);"
              >
                Tilbage
              </button>
              <button
                type="submit"
                id="submit-offer"
                class="flex-1 py-3 px-4 rounded-lg font-bold text-base transition-opacity hover:opacity-90"
                style="background: var(--color-primary); color: #fff; font-family: var(--font-body);"
              >
                Modtag mit tilbud
              </button>
            </div>
            <p
              id="submit-status"
              class="hidden text-sm font-semibold text-center mt-2 px-3 py-2 rounded-md border"
              style="font-family: var(--font-body);"
              role="status"
              aria-live="polite"
            ></p>
          </div>
        </div>
      </form>
    </div>

    <p class="text-center text-xs mt-4" style="color: var(--color-outline); font-family: var(--font-body);">
      100% uforpligtende · Svar inden for 24 timer
    </p>
  </div>
</section>

<script is:inline>
  const formSection = document.querySelector('[data-offer-form]');
  if (formSection) {
    const step1El = formSection.querySelector('#step1');
    const step2El = formSection.querySelector('#step2');
    const dot1 = formSection.querySelector('#step1-dot');
    const dot2 = formSection.querySelector('#step2-dot');
    const service = formSection.querySelector('#service');
    const timeline = formSection.querySelector('#timeline');
    const serviceError = formSection.querySelector('#service-error');
    const timelineError = formSection.querySelector('#timeline-error');
    const filesInput = formSection.querySelector('#billeder');
    const filesError = formSection.querySelector('#files-error');
    const selectedFilesWrapper = formSection.querySelector('#selected-files-wrapper');
    const selectedFilesList = formSection.querySelector('#selected-files-list');
    const step2Button = formSection.querySelector('#to-step2');
    const step1Button = formSection.querySelector('#to-step1');
    const addressInput = formSection.querySelector('#adresse');
    const phoneInput = formSection.querySelector('#telefon');
    const formEl = formSection.querySelector('#offer-form');
    const submitButton = formSection.querySelector('#submit-offer');
    const submitStatus = formSection.querySelector('#submit-status');
    const cloudName = formSection.dataset.cloudinaryCloudName;
    const uploadPreset = formSection.dataset.cloudinaryUploadPreset;
    const formspreeEndpoint = formSection.dataset.formspreeEndpoint;

    if (
      !step1El ||
      !step2El ||
      !dot1 ||
      !dot2 ||
      !service ||
      !timeline ||
      !serviceError ||
      !timelineError ||
      !filesInput ||
      !filesError ||
      !selectedFilesWrapper ||
      !selectedFilesList ||
      !step2Button ||
      !step1Button ||
      !addressInput ||
      !phoneInput ||
      !formEl ||
      !submitButton ||
      !submitStatus
    ) {
      console.warn('Offer form fields are not configured correctly.');
    } else {
      let filesAreValid = true;
      let selectedFiles = [];
      const defaultSubmitLabel = submitButton.textContent;

      const showStatus = (message, type) => {
        submitStatus.textContent = message;
        submitStatus.classList.remove('hidden');
        if (type === 'success') {
          submitStatus.style.color = '#1f6b2a';
          submitStatus.style.background = '#edf9f0';
          submitStatus.style.borderColor = '#b9e4c0';
        } else {
          submitStatus.style.color = '#c0392b';
          submitStatus.style.background = '#fff1ef';
          submitStatus.style.borderColor = '#f2c2bc';
        }
      };

      const setSubmittingState = (isSubmitting) => {
        submitButton.disabled = isSubmitting;
        submitButton.style.opacity = isSubmitting ? '0.7' : '1';
        submitButton.textContent = isSubmitting ? 'Sender...' : defaultSubmitLabel;
      };

      const validateStepOne = () => {
        const serviceIsValid = Boolean(service.value);
        const timelineIsValid = Boolean(timeline.value);

        serviceError.classList.toggle('hidden', serviceIsValid);
        timelineError.classList.toggle('hidden', timelineIsValid);

        return serviceIsValid && timelineIsValid && filesAreValid;
      };

      const createFileKey = (file) => `${file.name}-${file.size}-${file.lastModified}`;

      const renderSelectedFiles = () => {
        selectedFilesList.innerHTML = '';
        selectedFilesWrapper.classList.toggle('hidden', selectedFiles.length === 0);

        selectedFiles.forEach((file) => {
          const fileKey = createFileKey(file);
          const fileItem = document.createElement('li');
          fileItem.className = 'flex items-center justify-between gap-2 rounded-md px-3 py-2';
          fileItem.style.border = '1px solid var(--color-outline-variant)';
          fileItem.style.background = 'var(--color-surface-container-low)';

          const fileLabel = document.createElement('span');
          fileLabel.className = 'text-xs';
          fileLabel.style.color = 'var(--color-on-surface-variant)';
          fileLabel.style.fontFamily = 'var(--font-body)';
          fileLabel.textContent = file.name;

          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'text-xs font-semibold px-2 py-1 rounded';
          removeBtn.style.color = '#c0392b';
          removeBtn.style.fontFamily = 'var(--font-body)';
          removeBtn.style.border = '1px solid #e8b8b2';
          removeBtn.style.background = '#fff';
          removeBtn.textContent = 'Fjern';

          removeBtn.addEventListener('click', () => {
            selectedFiles = selectedFiles.filter((item) => createFileKey(item) !== fileKey);
            filesAreValid = selectedFiles.length <= 5;
            filesError.classList.add('hidden');
            renderSelectedFiles();
          });

          fileItem.appendChild(fileLabel);
          fileItem.appendChild(removeBtn);
          selectedFilesList.appendChild(fileItem);
        });
      };

      filesInput.addEventListener('change', () => {
        const newlyPickedFiles = filesInput.files ? Array.from(filesInput.files) : [];
        const uniqueNewFiles = newlyPickedFiles.filter((file) => {
          const key = createFileKey(file);
          return !selectedFiles.some((existingFile) => createFileKey(existingFile) === key);
        });

        const nextFiles = [...selectedFiles, ...uniqueNewFiles];
        filesAreValid = nextFiles.length <= 5;

        if (!filesAreValid) {
          filesError.classList.remove('hidden');
          filesAreValid = selectedFiles.length <= 5;
          filesInput.value = '';
          return;
        }

        selectedFiles = nextFiles;
        filesError.classList.add('hidden');
        filesInput.value = '';
        renderSelectedFiles();
      });

      step2Button.addEventListener('click', () => {
        if (!validateStepOne()) {
          return;
        }

        step1El.classList.add('hidden');
        step2El.classList.remove('hidden');

        dot1.textContent = '✓';
        dot2.style.background = 'var(--color-primary)';
        dot2.style.color = '#fff';
      });

      step1Button.addEventListener('click', () => {
        step2El.classList.add('hidden');
        step1El.classList.remove('hidden');

        dot1.textContent = '1';
        dot2.style.background = 'var(--color-surface-container)';
        dot2.style.color = 'var(--color-outline)';
      });

      service.addEventListener('change', () => {
        if (service.value) {
          serviceError.classList.add('hidden');
        }
      });

      timeline.addEventListener('change', () => {
        if (timeline.value) {
          timelineError.classList.add('hidden');
        }
      });

      phoneInput.addEventListener('input', () => {
        phoneInput.value = phoneInput.value.replace(/\D/g, '');
      });

      formEl.addEventListener('submit', async (event) => {
        event.preventDefault();
        submitStatus.classList.add('hidden');

        if (!cloudName || !uploadPreset) {
          showStatus('Cloudinary mangler opsætning. Tjek miljøvariablerne.', 'error');
          return;
        }

        if (!formspreeEndpoint) {
          showStatus('Formspree endpoint mangler. Kontakt support.', 'error');
          return;
        }

        if (!formEl.reportValidity()) {
          return;
        }

        if (selectedFiles.length > 5) {
          showStatus('Du kan kun vælge op til 5 billeder.', 'error');
          return;
        }

        const maxFileSizeInBytes = 5 * 1024 * 1024;
        const oversizedFile = selectedFiles.find((file) => file.size > maxFileSizeInBytes);
        if (oversizedFile) {
          showStatus(`Filen "${oversizedFile.name}" er for stor. Maksimum er 5 MB pr. fil.`, 'error');
          return;
        }

        setSubmittingState(true);

        try {
          const uploadTasks = selectedFiles.map(async (file) => {
            const uploadData = new FormData();
            uploadData.append('file', file);
            uploadData.append('upload_preset', uploadPreset);

            const cloudinaryResponse = await fetch(
              `https://api.cloudinary.com/v1_1/${cloudName}/auto/upload`,
              {
                method: 'POST',
                body: uploadData,
              }
            );

            if (!cloudinaryResponse.ok) {
              const cloudinaryErrorData = await cloudinaryResponse.json().catch(() => null);
              const errorMessage =
                cloudinaryErrorData &&
                cloudinaryErrorData.error &&
                cloudinaryErrorData.error.message
                  ? cloudinaryErrorData.error.message
                  : 'Cloudinary upload failed.';
              throw new Error(errorMessage);
            }

            const cloudinaryResult = await cloudinaryResponse.json();
            if (!cloudinaryResult.secure_url) {
              throw new Error('Cloudinary did not return an image URL.');
            }

            return cloudinaryResult.secure_url;
          });

          const uploadedImageUrls = await Promise.all(uploadTasks);
          const formPayload = new FormData(formEl);
          formPayload.delete('billeder[]');
          formPayload.delete('billeder_links');

          if (uploadedImageUrls.length > 0) {
            uploadedImageUrls.forEach((url, index) => {
              formPayload.append(`billede_link_${index + 1}`, url);
            });

            formPayload.append(
              'billeder_links',
              uploadedImageUrls.map((url, index) => `${index + 1}. ${url}`).join('\n')
            );
          } else {
            formPayload.append('billeder_links', 'Ingen billeder uploadet');
          }

          const formspreeResponse = await fetch(formspreeEndpoint, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
            },
            body: formPayload,
          });

          if (!formspreeResponse.ok) {
            throw new Error('Formspree submission failed.');
          }

          formEl.reset();
          selectedFiles = [];
          renderSelectedFiles();
          filesError.classList.add('hidden');
          serviceError.classList.add('hidden');
          timelineError.classList.add('hidden');
          step2El.classList.add('hidden');
          step1El.classList.remove('hidden');
          dot1.textContent = '1';
          dot2.style.background = 'var(--color-surface-container)';
          dot2.style.color = 'var(--color-outline)';

          showStatus('Tak for din henvendelse! Vi har modtaget din formular og vender tilbage inden for 24 timer.', 'success');
        } catch (error) {
          console.error(error);
          showStatus('Der opstod en fejl ved afsendelse. Prøv igen om et øjeblik.', 'error');
        } finally {
          setSubmittingState(false);
        }
      });

      const initializeAddressAutocomplete = () => {
        if (!window.dawaAutocomplete || !window.dawaAutocomplete.dawaAutocomplete) {
          return;
        }

        window.dawaAutocomplete.dawaAutocomplete(addressInput, {
          minLength: 2,
          select: (selected) => {
            addressInput.value = selected.tekst;
          },
        });
      };

      const dawaScript = document.createElement('script');
      dawaScript.src = 'https://cdn.dataforsyningen.dk/dawa/assets/dawa-autocomplete2/1.0.2/dawa-autocomplete2.min.js';
      dawaScript.onload = initializeAddressAutocomplete;
      dawaScript.onerror = () => {
        console.warn('DAWA autocomplete failed to load. Address field will remain manual.');
      };
      document.head.appendChild(dawaScript);
    }
  }
</script>

<style>
  .autocomplete-container {
    position: relative;
    width: 100%;
  }

  .dawa-autocomplete-suggestions {
    margin: 0.4rem 0 0 0;
    padding: 0;
    text-align: left;
    border-radius: 0.5rem;
    border: 1px solid var(--color-outline-variant);
    background: #fff;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
    position: absolute;
    left: 0;
    right: 0;
    z-index: 40;
    max-height: 260px;
    overflow-y: auto;
  }

  .dawa-autocomplete-suggestions .dawa-autocomplete-suggestion {
    margin: 0;
    list-style: none;
    cursor: pointer;
    padding: 0.6rem 0.75rem;
    color: var(--color-on-background);
    border-bottom: 1px solid var(--color-outline-variant);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .dawa-autocomplete-suggestions .dawa-autocomplete-suggestion:last-child {
    border-bottom: 0;
  }

  .dawa-autocomplete-suggestions .dawa-autocomplete-suggestion.dawa-selected,
  .dawa-autocomplete-suggestions .dawa-autocomplete-suggestion:hover {
    background: var(--color-surface-container-low);
  }
</style>
