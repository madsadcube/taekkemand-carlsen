---
// C Stats bar — strammere end SocialProofB.
//   • Bg = cream → ingen brud i flow fra hero
//   • Hairline-rule top/bund i stedet for ::before
//   • 4 stats men kun ÉN ikon-stil (linje, samme stroke)
---

<section class="c-stats" aria-label="Sociale beviser">
  <div class="c-container">
    <div class="c-stats-grid">

      <div class="c-stat">
        <svg class="c-stat-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 8v4l3 2"/>
          <circle cx="12" cy="12" r="10"/>
        </svg>
        <div>
          <div class="c-stat-num">15+ år</div>
          <div class="c-stat-label">Tækkeerfaring</div>
        </div>
      </div>

      <div class="c-stat">
        <svg class="c-stat-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="16" rx="1"/>
          <path d="M8 3v4M16 3v4M3 11h18"/>
          <path d="M9 16l2 2 4-4"/>
        </svg>
        <div>
          <div class="c-stat-num">90 dage</div>
          <div class="c-stat-label">Garanteret levering</div>
        </div>
      </div>

      <div class="c-stat">
        <svg class="c-stat-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L3 7v5c0 5 3.5 8.5 9 10 5.5-1.5 9-5 9-10V7l-9-5z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
        <div>
          <div class="c-stat-num">12 mio. kr</div>
          <div class="c-stat-label">Alm. Brand-forsikret</div>
        </div>
      </div>

      <div class="c-stat">
        <svg class="c-stat-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1118 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <div>
          <div class="c-stat-num">Nordsjælland</div>
          <div class="c-stat-label">Vores område</div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .c-stats {
    background: var(--c-bg-surface);
    padding: 32px 0 56px;
    position: relative;
  }
  .c-stats::before {
    content: '';
    position: absolute;
    top: 0; left: 8%; right: 8%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(111, 67, 21, 0.28), transparent);
  }

  .c-stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
  }
  .c-stat {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .c-stat-icon {
    width: 44px; height: 44px;
    padding: 10px;
    border-radius: 50%;
    background: var(--c-brand-soft);
    color: var(--c-brand);
    flex-shrink: 0;
    box-sizing: border-box;
    transition: background 0.25s, color 0.25s;
  }
  .c-stat:hover .c-stat-icon {
    background: var(--c-brand);
    color: var(--c-white);
  }
  .c-stat-num {
    font-family: var(--font-headline);
    font-size: 1.4rem;
    color: var(--c-ink);
    line-height: 1.1;
    font-weight: 500;
  }
  .c-stat-label {
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--c-ink-faint);
    margin-top: 6px;
  }

  @media (min-width: 768px) {
    .c-stats-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }
  }
</style>
