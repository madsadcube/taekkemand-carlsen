---
const pricing = [
  { name: 'Nyt stråtag', price: 'Ca. 936 kr/m²', what: ['Tækkearbejde inkl. materialer (ekskl. moms)', 'Vandrør, halm, lyng eller kobber til rygning', 'Endelig pris efter opmåling', 'Levering inden 90 dage'] },
  { name: 'Renovering', price: 'Ca. 388 kr/m²', what: ['Ca. 1/3 af prisen for nyt tag', 'Brandsikring kan ofte genbruges', '70-80% af strået genbruges', 'Forlænger levetiden 20-25 år'] },
  { name: 'Mønning', price: 'Fra 450 kr/m', what: ['Havrehalm: 450 kr/m (ekskl. moms)', 'Lyng: 900 kr/m (ekskl. moms)', 'Tang: 900 kr/m (ekskl. moms)', 'Tillæg for stillads og stige', 'Typisk udført inden for 8 uger'] },
  { name: 'Algebehandling', price: 'Fra 2.500 kr', what: ['0–200 m²: 2.500 kr (+moms)', '201–300 m²: 2.700 kr (+moms)', '301–400 m²: 2.900 kr (+moms)', '401–500 m²: 3.100 kr (+moms)'] },
  { name: 'Vedligeholdelse', price: 'Fra 79 kr/m²', what: ['Grundpakke (manuel rensning): 79 kr/m²', 'Tillæg (finpudsning): +89 kr/m²', 'Forlænger levetiden 8-10 år', 'Faste aftaler mulige'] },
]
---

<section class="c-pricing c-section" id="priser">
  <div class="c-container">
    <div class="c-head-center">
      <span class="c-eyebrow">Vejledende priser</span>
      <h2 class="c-h2">
        <span class="c-h2-italic">Klare priser</span> — ingen overraskelser.
      </h2>
      <p class="c-lede">
        Her er vores vejledende priser. Hvert projekt får et uforpligtende tilbud — ofte ud fra skråfoto —
        så du har et præcist tal at forholde dig til.
      </p>
    </div>

    <div class="c-pr-grid">
      {pricing.map((p) => (
        <div class={`c-pr-card ${p.featured ? 'c-pr-card--featured' : ''}`}>
          {p.featured && <div class="c-pr-badge">Mest valgt</div>}
          <h3 class="c-pr-name">{p.name}</h3>
          <div class="c-pr-price">{p.price}</div>
          <ul class="c-pr-list">
            {p.what.map((w) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>{w}</span>
              </li>
            ))}
          </ul>
          <a href="#kontakt" class={`c-btn ${p.featured ? 'c-btn--primary' : 'c-btn--outline'} c-pr-cta`}>
            Få fastpris
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      ))}
    </div>

    <div class="c-pr-note">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span>Priserne er vejledende for Nordsjælland og kan variere ved kørsel til fjernere byer. Algebehandling og rygning/mønning er ekskl. moms. Der kan tilkomme tillæg for stillads og stige. Prisen på nyt stråtag er vejledende og fastsættes endeligt efter opmåling.</span>
    </div>
  </div>
</section>

<style>
  .c-pricing { background: var(--c-bg-surface); }

  .c-pr-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: stretch;
  }
  .c-pr-card {
    background: var(--c-white);
    padding: 32px 28px;
    border-radius: var(--c-r-lg);
    border: 1px solid var(--c-brand-soft);
    box-shadow: var(--c-shadow-sm);
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .c-pr-card--featured {
    border: 2px solid var(--c-brand);
    box-shadow: 0 16px 40px rgba(111, 67, 21, 0.15);
  }
  .c-pr-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--c-brand);
    color: var(--c-white);
    padding: 6px 16px;
    border-radius: var(--c-r-pill);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
  }
  .c-pr-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--c-ink);
    margin: 0 0 8px;
  }
  .c-pr-price {
    font-family: var(--font-headline);
    font-style: italic;
    font-size: 2rem;
    color: var(--c-brand);
    margin-bottom: 24px;
    line-height: 1;
  }
  .c-pr-list {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .c-pr-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--c-ink);
    line-height: 1.5;
  }
  .c-pr-list svg { color: var(--c-brand); flex-shrink: 0; margin-top: 3px; }

  .c-pr-cta { padding: 13px 22px; font-size: 0.95rem; }

  .c-pr-note {
    display: flex; align-items: flex-start; gap: 12px;
    margin-top: 40px;
    padding: 16px 20px;
    background: var(--c-brand-faint);
    border-left: 3px solid var(--c-brand);
    border-radius: var(--c-r-sm);
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--c-ink-soft);
    line-height: 1.5;
  }
  .c-pr-note svg { color: var(--c-brand); flex-shrink: 0; margin-top: 2px; }

  @media (min-width: 768px) {
    .c-pr-grid { grid-template-columns: repeat(2, 1fr); gap: 28px; }
  }
  @media (min-width: 1100px) {
    .c-pr-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
