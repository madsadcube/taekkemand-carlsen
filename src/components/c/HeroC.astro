---
// C Hero — samme editorial 2-col som B, men:
//   • Brun = ÉN nuance (var(--c-brand) #6f4315)
//   • Knap = rounded 8px (matcher resten af siden) — ikke sharp som B
//   • Trust-stripe forenkles til Google-stjerne + by + forsikring
//   • Foto-side: vendt med stempel-trick, men subtilere
---

<section class="c-hero">
  <div class="c-hero-container">
    <div class="c-hero-text">
      <div class="c-hero-eyebrow">
        <span class="c-hero-stars" aria-label="4,6 ud af 5 stjerner">★★★★★</span>
        <strong>4,6/5</strong>
        <span class="c-hero-sep">·</span>
        <span>+100 kunder i Nordsjælland</span>
      </div>

      <h1 class="c-hero-h1">
        Lokal tækkemand i Nordsjælland<br/>
        <span class="c-hero-h1-italic">— smukt og holdbart håndværk</span>
      </h1>

      <p class="c-hero-sub">
        Nyt stråtag, mønning, reparation og algebehandling — leveret inden 90 dage.
        Forsikret hos Alm. Brand op til 12 mio. kr.
      </p>

      <div class="c-hero-cta">
        <a href="#kontakt" class="c-btn c-btn--primary">
          Få uforpligtende tilbud
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="tel:+4524248080" class="c-phone">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span>eller ring <strong>24 24 80 80</strong></span>
        </a>
      </div>
    </div>

    <aside class="c-hero-art" aria-hidden="true">
      <figure class="c-hero-photo">
        <img src="/img/straatag1-hero.jpg" alt="" loading="eager" fetchpriority="high"/>
      </figure>
    </aside>
  </div>
</section>

<style>
  .c-hero {
    background: var(--c-bg-cream);
    color: var(--c-ink);
    padding: 128px 0 64px;
    position: relative;
    overflow: hidden;
  }
  .c-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px 24px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  .c-hero-text { max-width: 560px; }

  .c-hero-eyebrow {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 10px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--c-ink-soft);
    padding-bottom: 14px;
    margin-bottom: 28px;
    border-bottom: 1px solid rgba(111, 67, 21, 0.25);
  }
  .c-hero-eyebrow strong { color: var(--c-ink); font-weight: 700; }
  .c-hero-stars { color: var(--c-gold); letter-spacing: 2px; }
  .c-hero-sep { color: rgba(81, 68, 58, 0.4); }

  .c-hero-h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.5rem, 5.4vw, 4.1rem);
    line-height: 1.02;
    color: var(--c-ink);
    margin: 0 0 28px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .c-hero-h1-italic {
    display: inline-block;
    padding-top: 6px;
    font-style: italic;
    color: var(--c-brand);
    font-weight: 400;
  }

  .c-hero-sub {
    font-family: var(--font-body);
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--c-ink-soft);
    margin: 0 0 36px;
    max-width: 480px;
  }

  .c-hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }

  .c-hero-art { position: relative; display: none; }

  .c-hero-photo {
    margin: 0;
    width: 100%;
    aspect-ratio: 4/5;
    overflow: hidden;
    border-radius: var(--c-r-md);
    box-shadow: var(--c-shadow-lg);
    position: relative;
  }
  .c-hero-photo img {
    display: block; width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(1.02) saturate(1.04);
  }

  @media (min-width: 1024px) {
    .c-hero { padding: 144px 0 80px; }
    .c-hero-container {
      grid-template-columns: 5fr 6fr;
      gap: 80px;
      padding: 0 48px;
    }
    .c-hero-art { display: block; }
  }
</style>
