---
const reviews = [
  { title: 'De holder hvad de lover', text: 'Vi har netop fået nyt stråtag på hovedhuset ved stranden samt pudset annekset af (16 år gammelt). Jeg har fulgt arbejdet på tætteste hold og kan varmt anbefale Jacob og hans team.', name: 'Peter Sonne Christensen', meta: 'Nyt stråtag', rating: 5 },
  { title: 'Super glade…', text: 'Vi har fået nyt tag og er super glade for det arbejde der er blevet lavet. Jacob og Matias er et par flinke fyre og holder hvad de lover.', name: 'Christian Pfeil Bendtsen', meta: 'Nyt stråtag', rating: 5 },
  { title: 'Fantastisk stykke arbejde', text: 'Jakob har lavet et fantastisk stykke arbejde. Han er omhyggelig og man mærker at hans faglige stolthed betyder alt for ham. Meget regulær og til at stole på.', name: 'Børge Jensen', meta: 'Mønning', rating: 5 },
  { title: 'Kan varmt anbefales…', text: 'Vi har fået nyt stråtag på vores gamle stuehus. Begge utrolig kompetente, samvittighedsfulde og dygtige til deres håndværk.', name: 'Anne-mette Bendtsen', meta: 'Nyt stråtag', rating: 5 },
  { title: 'Dedikerede tækkemænd', text: 'Samarbejdet med Jacob har været helt igennem positivt og fleksibelt, også selv om opgaven blev løst hen over en vinter med frost og sne.', name: 'Thomas Brandt', meta: 'Nyt stråtag', rating: 5 },
  { title: 'Overskueligt tilbud', text: 'Tilbuddet var gennemskueligt og detaljeret. Arbejdet blev udført som aftalt, og vi blev løbende informeret undervejs.', name: 'Kasper Andreasen', meta: 'Renovering', rating: 5 },
]
---

<section class="c-test c-section" id="anmeldelser">
  <div class="c-container">
    <div class="c-test-head">
      <div class="c-test-head-text">
        <span class="c-eyebrow">Anmeldelser</span>
        <h2 class="c-h2">
          Vi samler på <span class="c-h2-italic">glade kunder</span>.
        </h2>
      </div>
      <div class="c-test-google" aria-label="5,0 stjerner på Google">
        <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <div>
          <div class="c-test-google-stars">★★★★★ <strong>5,0</strong></div>
          <div class="c-test-google-label">Google Anmeldelser</div>
        </div>
      </div>
    </div>

    <div class="c-test-grid">
      {reviews.map((r) => (
        <article class="c-test-card">
          <div class="c-test-stars">{'★'.repeat(r.rating)}</div>
          <h3 class="c-test-title">"{r.title}"</h3>
          <p class="c-test-text">{r.text}</p>
          <div class="c-test-attr">
            <div class="c-test-name">{r.name}</div>
            <div class="c-test-meta">{r.meta}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .c-test { background: var(--c-bg-cream); }

  .c-test-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 56px;
  }
  .c-test-head-text { max-width: 720px; }
  .c-test-head-text .c-h2 { margin: 0; }

  .c-test-google {
    display: inline-flex; align-items: center; gap: 14px;
    padding: 14px 20px;
    background: var(--c-white);
    border-radius: var(--c-r-md);
    border: 1px solid var(--c-brand-soft);
    box-shadow: var(--c-shadow-sm);
  }
  .c-test-google-stars {
    font-family: var(--font-body);
    color: var(--c-gold);
    font-size: 0.95rem;
    letter-spacing: 1px;
  }
  .c-test-google-stars strong {
    color: var(--c-ink);
    margin-left: 6px;
    font-weight: 700;
    letter-spacing: 0;
  }
  .c-test-google-label {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--c-ink-soft);
    margin-top: 2px;
  }

  .c-test-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .c-test-card {
    background: var(--c-white);
    padding: 28px;
    border-radius: var(--c-r-lg);
    border: 1px solid var(--c-brand-soft);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .c-test-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--c-shadow-md);
  }
  .c-test-stars { color: var(--c-gold); font-size: 1.05rem; letter-spacing: 2px; margin-bottom: 14px; }
  .c-test-title {
    font-family: var(--font-headline);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--c-ink);
    margin: 0 0 10px;
    font-weight: 500;
    line-height: 1.25;
  }
  .c-test-text {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--c-ink-soft);
    margin: 0 0 20px;
  }
  .c-test-attr {
    padding-top: 16px;
    border-top: 1px solid var(--c-brand-soft);
  }
  .c-test-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--c-ink);
  }
  .c-test-meta {
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--c-ink-soft);
    margin-top: 2px;
  }

  @media (min-width: 768px) {
    .c-test-head { flex-direction: row; align-items: flex-end; }
    .c-test-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .c-test-grid { grid-template-columns: repeat(3, 1fr); gap: 28px; }
  }
</style>
