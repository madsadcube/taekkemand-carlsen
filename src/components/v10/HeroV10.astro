---
// V10 Hero — V5's trust-first venstreside + V8's photo-journal højreside + EST. 1972 stempel
---

<section class="v10-hero">
  <div class="v10-hero-bg-pattern"></div>

  <div class="v10-hero-container">
    <div class="v10-hero-copy">
      <div class="v10-hero-rating">
        <span class="v10-rating-text">Tækkefirma med <strong>15+ års erfaring</strong> · Primært Sjælland</span>
      </div>

      <h1 class="v10-h1">
        Nyt stråtag på Sjælland — <span class="v10-h1-italic">leveret inden 90 dage</span>
      </h1>

      <p class="v10-sub">
        Et håndværk i <em>Carlsens fodspor</em> siden 1972. Få et uforpligtende tilbud på nyt stråtag, mønning, reparation eller algebehandling.
      </p>

      <div class="v10-pillars">
        <div class="v10-pillar">
          <svg class="v10-pillar-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <div class="v10-pillar-body">
            <span class="v10-pillar-title">90 dage</span>
            <span class="v10-pillar-meta">Garanteret levering</span>
          </div>
        </div>
        <div class="v10-pillar">
          <svg class="v10-pillar-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <div class="v10-pillar-body">
            <span class="v10-pillar-title">15+ år</span>
            <span class="v10-pillar-meta">Tækkeerfaring</span>
          </div>
        </div>
        <div class="v10-pillar">
          <svg class="v10-pillar-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <div class="v10-pillar-body">
            <span class="v10-pillar-title">12 mio. kr</span>
            <span class="v10-pillar-meta">Forsikret hos Alm. Brand</span>
          </div>
        </div>
      </div>

      <div class="v10-cta">
        <a href="#kontakt" class="v10-btn-primary">Få fastpris på dit projekt</a>
        <a href="tel:+4524248080" class="v10-btn-phone">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Ring: 24 24 80 80
        </a>
      </div>
    </div>

    <div class="v10-hero-photos">
      <div class="v10-stamp">
        <div class="v10-stamp-line">EST.</div>
        <div class="v10-stamp-year">1972</div>
      </div>

      <figure class="v10-photo v10-p1">
        <img src="/img/straatag1-hero.jpg" alt="Færdiglagt stråtag" loading="eager" fetchpriority="high"/>
        <figcaption class="v10-cap">№01 / Nyt stråtag, Tisvilde</figcaption>
      </figure>
      <figure class="v10-photo v10-p2">
        <img src="/img/rygning.jpg" alt="Mønning under arbejde" loading="lazy"/>
        <figcaption class="v10-cap">№02 / Mønning, foråret '26</figcaption>
      </figure>
      <figure class="v10-photo v10-p3">
        <img src="/img/rep_straatag4.jpeg" alt="Detaljer på stråtag" loading="lazy"/>
        <figcaption class="v10-cap">№03 / Detalje</figcaption>
      </figure>

      <span class="v10-tape v10-tape-1"></span>
      <span class="v10-tape v10-tape-2"></span>
    </div>
  </div>

  <div class="v10-trust-row-wrapper">
    <div class="v10-trust-row">
      <span class="v10-trust-item">✓ Forsikret op til 12 mio. kr.</span>
      <span class="v10-trust-item">✓ Primært Sjælland</span>
      <span class="v10-trust-item">✓ Uforpligtende tilbud</span>
      <span class="v10-trust-item">✓ CVR 44410976</span>
    </div>
  </div>
</section>

<style>
  .v10-hero { position: relative; padding-top: 96px; padding-bottom: 0; background: #f4ede2; overflow: hidden; color: #1b1c1c; }
  .v10-hero-bg-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    background-image:
      radial-gradient(circle at 12% 22%, rgba(111,67,21,0.05) 0%, transparent 30%),
      radial-gradient(circle at 88% 78%, rgba(111,67,21,0.05) 0%, transparent 35%);
    pointer-events: none;
  }

  .v10-hero-container {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 24px 64px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  .v10-hero-copy { position: relative; }

  .v10-hero-rating { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
  .v10-rating-text { font-family: var(--font-body); font-size: 0.9rem; color: #51443a; }

  .v10-h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: #1b1c1c;
    margin: 0 0 24px;
    font-weight: 500;
  }
  .v10-h1-italic { font-style: italic; color: #6f4315; }

  .v10-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    color: #51443a;
    margin: 0 0 32px;
    max-width: 540px;
  }
  .v10-sub em { font-family: var(--font-headline); font-style: italic; color: #1b1c1c; font-size: 1.1em; }

  .v10-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 28px;
    margin-bottom: 28px;
    max-width: 540px;
  }
  .v10-pillar { display: flex; align-items: center; gap: 10px; }
  .v10-pillar-check { flex-shrink: 0; color: #6f4315; }
  .v10-pillar-body { display: flex; flex-direction: column; line-height: 1.2; }
  .v10-pillar-title { font-family: var(--font-body); font-weight: 700; font-size: 0.92rem; color: #1b1c1c; }
  .v10-pillar-meta { font-family: var(--font-body); font-size: 0.78rem; color: #6b5a4d; }

  .v10-cta { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; }
  .v10-btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    background: #6f4315; color: #fff;
    padding: 18px 32px;
    font-family: var(--font-body); font-weight: 700;
    font-size: 1.05rem;
    border-radius: 10px;
    transition: transform 0.3s, background 0.3s;
    box-shadow: 0 8px 24px rgba(111,67,21,0.25);
  }
  .v10-btn-primary:hover { transform: translateY(-2px); background: #8b5a2b; }
  .v10-btn-phone {
    display: inline-flex; align-items: center; gap: 8px;
    color: #1b1c1c;
    padding: 18px 24px;
    font-family: var(--font-body); font-weight: 700;
    font-size: 1.05rem;
    border-radius: 10px;
    border: 1px solid rgba(27,28,28,0.2);
    background: rgba(255,255,255,0.5);
  }

  /* Photo journal højre side */
  .v10-hero-photos { position: relative; min-height: 460px; }
  .v10-stamp {
    position: absolute;
    top: -16px; right: 8px;
    width: 96px; height: 96px;
    border: 2px solid #6f4315;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #6f4315;
    font-family: var(--font-label);
    transform: rotate(-8deg);
    opacity: 0.92;
    z-index: 20;
    background: rgba(244,237,226,0.85);
  }
  .v10-stamp-line { font-size: 10px; letter-spacing: 0.25em; }
  .v10-stamp-year { font-family: var(--font-headline); font-size: 1.75rem; font-style: italic; line-height: 1; }

  .v10-photo {
    position: absolute;
    background: #fff;
    padding: 12px 12px 32px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.18);
    margin: 0;
  }
  .v10-photo img { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: inherit; }
  .v10-cap {
    font-family: var(--font-body); font-style: italic;
    font-size: 0.78rem; color: #51443a;
    text-align: center; padding-top: 8px;
  }
  .v10-p1 { width: 70%; aspect-ratio: 4/3; top: 0; right: 0; transform: rotate(2.5deg); z-index: 1; }
  .v10-p2 { width: 45%; aspect-ratio: 3/4; bottom: 8%; left: 0; transform: rotate(-4deg); z-index: 2; }
  .v10-p3 { width: 38%; aspect-ratio: 1; bottom: 0; right: 12%; transform: rotate(5deg); z-index: 3; }

  .v10-tape {
    position: absolute; width: 80px; height: 22px;
    background: rgba(255,220,193,0.7);
    backdrop-filter: blur(2px); z-index: 10;
  }
  .v10-tape-1 { top: -6px; left: 32%; transform: rotate(-12deg); }
  .v10-tape-2 { bottom: 22%; right: 38%; transform: rotate(8deg); width: 60px; }

  /* Trust row band nederst */
  .v10-trust-row-wrapper {
    background: #1b1c1c;
    padding: 16px 24px;
  }
  .v10-trust-row {
    max-width: 1400px;
    margin: 0 auto;
    display: flex; flex-wrap: wrap; gap: 24px;
    justify-content: center;
  }
  .v10-trust-item { font-family: var(--font-body); font-size: 0.85rem; color: #ffdcc1; }

  @media (min-width: 1024px) {
    .v10-hero-container { grid-template-columns: 5fr 6fr; gap: 80px; padding: 48px 56px 96px; }
    .v10-hero-photos { min-height: 600px; }
    .v10-stamp { width: 110px; height: 110px; top: -24px; right: -8px; }
  }
</style>
