---
const reviews = [
  { text: 'Algebehandlingen har gjort en kæmpe forskel — taget ser ud som nyt igen. Roligt arbejde, ren plads bagefter.', name: 'Henning S.', meta: 'Frederiksværk · Algebehandling · 2026', rating: 5 },
  { text: 'Vi har fået nyt stråtag fra oktober 2018 til januar 2019. Og er super glade for det arbejde der er blevet lavet. Jacob og Matias er et par flinke fyre og holder hvad de lover. Vi vil helt sikkert anbefale Tækkemand Carlsen.', name: 'Christian Pfeil Bendtsen', meta: 'Nyt stråtag · 2018–2019', rating: 5 },
  { text: 'Jakob har lavet et fantastisk stykke arbejde. Han er omhyggelig og man mærker at hans faglige stolthed betyder alt for ham. Det kan man tydeligt se på arbejdet, og samtidig er han meget regulær og til at stole på.', name: 'Børge Jensen', meta: 'Stråtag · Reparation', rating: 5 },
  { text: 'Vi har fået nyt stråtag på vores gamle stuehus, og det har Tækkemand Carlsen stået for. Vi har fået et super flot resultat — Jacob og Mathias er begge utrolig kompetente, samvittighedsfulde og dygtige til deres håndværk.', name: 'Anne-Mette B. Bendtsen', meta: 'Nyt stråtag · Stuehus', rating: 5 },
  { text: 'Vi har netop fået nyt stråtag på hovedhuset ved stranden samt pudset annekset af (16 år gammelt). Jeg har fulgt arbejdet på tætteste hold og kan varmt anbefale Jacob og hans team. Effektive og dygtige.', name: 'Peter Sonne Christensen', meta: 'Nyt tag + algebehandling', rating: 5 },
]
---

<section class="alge-test">
  <div class="alge-t-container">
    <div class="alge-t-head">
      <span class="alge-eyebrow">Anmeldelser</span>
      <h2 class="alge-h2">
        4,9 ud af 5 stjerner — <span class="alge-h2-italic">og det betyder noget.</span>
      </h2>
      <div class="alge-t-platforms">
        <div class="alge-platform">
          <div class="alge-stars-row">★★★★★</div>
          <div class="alge-platform-name">Google · 4,9</div>
        </div>
        <div class="alge-platform-divider"></div>
        <div class="alge-platform">
          <div class="alge-stars-row">★★★★★</div>
          <div class="alge-platform-name">Trustpilot · 4,9</div>
        </div>
        <div class="alge-platform-divider"></div>
        <div class="alge-platform">
          <div class="alge-stars-row">★★★★★</div>
          <div class="alge-platform-name">Facebook · 5,0</div>
        </div>
      </div>
    </div>

    <div class="alge-t-grid">
      {reviews.map((r) => (
        <article class="alge-t-card">
          <div class="alge-t-stars">{'★'.repeat(r.rating)}</div>
          <p class="alge-t-text">{r.text}</p>
          <div class="alge-t-attr">
            <div class="alge-t-name">{r.name}</div>
            <div class="alge-t-meta">{r.meta}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .alge-test { background: #fbf9f8; padding: 96px 0; }
  .alge-t-container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .alge-t-head { text-align: center; max-width: 720px; margin: 0 auto 56px; }
  .alge-eyebrow { font-family: var(--font-label); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: #6f4315; display: block; margin-bottom: 16px; }
  .alge-h2 { font-family: var(--font-headline); font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.2; color: #1b1c1c; margin: 0 0 24px; font-weight: 500; }
  .alge-h2-italic { font-style: italic; color: #6f4315; }
  .alge-t-platforms { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 16px; padding: 16px 24px; background: #fff; border-radius: 999px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
  .alge-platform { text-align: center; }
  .alge-stars-row { color: #d4a017; font-size: 1rem; letter-spacing: 1px; line-height: 1; }
  .alge-platform-name { font-family: var(--font-body); font-size: 0.85rem; font-weight: 700; color: #1b1c1c; margin-top: 4px; }
  .alge-platform-divider { width: 1px; height: 28px; background: rgba(111,67,21,0.2); }

  .alge-t-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  .alge-t-card { background: #fff; padding: 28px; border-radius: 16px; border: 1px solid rgba(111,67,21,0.1); transition: transform 0.3s, box-shadow 0.3s; }
  .alge-t-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.08); }
  .alge-t-stars { color: #d4a017; font-size: 1.05rem; letter-spacing: 2px; margin-bottom: 16px; }
  .alge-t-text { font-family: var(--font-body); font-size: 1rem; line-height: 1.7; color: #1b1c1c; margin: 0 0 20px; }
  .alge-t-attr { padding-top: 16px; border-top: 1px solid rgba(111,67,21,0.15); }
  .alge-t-name { font-family: var(--font-body); font-weight: 700; font-size: 0.95rem; color: #1b1c1c; }
  .alge-t-meta { font-family: var(--font-body); font-size: 0.82rem; color: #51443a; margin-top: 2px; }

  @media (min-width: 640px) { .alge-t-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .alge-t-grid { grid-template-columns: repeat(3, 1fr); gap: 28px; } }
</style>
</content>
</invoke>