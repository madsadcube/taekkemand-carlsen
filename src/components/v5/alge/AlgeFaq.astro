---
const faqs = [
  { q: 'Hvor ofte skal stråtaget algebehandles?', a: 'Som hovedregel hvert 5.–8. år, afhængigt af tagets placering. Tag i skygge, ved skov eller med nordvendte sider får mos hurtigere og bør tilses oftere. Vi anbefaler tilsyn hvert 2.–3. år, så du kan få behandlet i tide.' },
  { q: 'Er behandlingen miljøvenlig?', a: 'Ja. Vi bruger udelukkende et godkendt, økologisk middel der er biologisk nedbrydeligt. Vi bruger ikke biocider eller klorholdige produkter, der skader hverken tag, planter, husdyr eller grundvand.' },
  { q: 'Hvor lang tid tager behandlingen?', a: 'Typisk 4–6 timer afhængigt af tagets størrelse og angrebsgrad. Du behøver ikke være hjemme — vi giver besked når vi er færdige og sender fakturaen efter aftale.' },
  { q: 'Skader middlet planter eller husdyr?', a: 'Nej. Middlet er kun aktivt mod alger og svampesporer på selve taget. Vi tildækker eventuelt sårbare planter under tagudhænget for en sikkerheds skyld, og husdyr kan opholde sig i haven med det samme.' },
  { q: 'Hvor længe virker det?', a: 'Behandlingen forebygger ny algevækst i typisk 5–8 år. Det er ikke en livslang løsning — alger kommer altid tilbage med tiden — men en regelmæssig behandling holder taget i topform.' },
  { q: 'Hvad koster algebehandling?', a: 'Vejledende fra 8.000 kr for et mindre tag (under 150 m²) op til 16.000+ kr for større tage. Endelig pris fastsættes efter inspektion. Se priser længere oppe på siden.' },
  { q: 'Kan I behandle hele Sjælland?', a: 'Ja. Vi har base i Helsinge / Ringsted og servicerer hele Sjælland — Nordsjælland, Vestsjælland, Sydsjælland og Storkøbenhavn. Spørg gerne ved bestilling.' },
]
---

<section class="alge-faq" id="faq">
  <div class="alge-faq-container">
    <div class="alge-faq-head">
      <span class="alge-eyebrow">Spørgsmål & svar</span>
      <h2 class="alge-h2">
        Det folk <span class="alge-h2-italic">plejer at spørge om.</span>
      </h2>
    </div>

    <div class="alge-faq-list">
      {faqs.map((f) => (
        <details class="alge-faq-item">
          <summary>
            <span>{f.q}</span>
            <span class="alge-faq-icon">+</span>
          </summary>
          <div class="alge-faq-a">{f.a}</div>
        </details>
      ))}
    </div>

    <div class="alge-faq-foot">
      <p>Et spørgsmål, vi ikke har svaret på her?</p>
      <a href="#kontakt">Skriv til os →</a>
    </div>
  </div>
</section>

<style>
  .alge-faq { background: #f4ede2; padding: 96px 0; }
  .alge-faq-container { max-width: 880px; margin: 0 auto; padding: 0 24px; }
  .alge-faq-head { text-align: center; margin-bottom: 56px; }
  .alge-eyebrow { font-family: var(--font-label); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: #6f4315; display: block; margin-bottom: 16px; }
  .alge-h2 { font-family: var(--font-headline); font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.2; color: #1b1c1c; margin: 0; font-weight: 500; }
  .alge-h2-italic { font-style: italic; color: #6f4315; }

  .alge-faq-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; }
  .alge-faq-item {
    background: #fff; border: 1px solid rgba(111,67,21,0.12);
    border-radius: 12px; overflow: hidden;
    transition: box-shadow 0.3s;
  }
  .alge-faq-item[open] { box-shadow: 0 8px 24px rgba(0,0,0,0.06); }
  .alge-faq-item summary {
    list-style: none; cursor: pointer;
    padding: 20px 24px;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    font-family: var(--font-body); font-weight: 700; font-size: 1.05rem; color: #1b1c1c;
  }
  .alge-faq-item summary::-webkit-details-marker { display: none; }
  .alge-faq-icon {
    flex-shrink: 0; width: 28px; height: 28px;
    border-radius: 50%; background: rgba(111,67,21,0.1); color: #6f4315;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.25rem; font-weight: 400; transition: transform 0.3s;
  }
  .alge-faq-item[open] .alge-faq-icon { transform: rotate(45deg); }
  .alge-faq-a {
    padding: 0 24px 20px;
    font-family: var(--font-body); font-size: 0.98rem; line-height: 1.7; color: #51443a;
  }

  .alge-faq-foot { text-align: center; }
  .alge-faq-foot p { font-family: var(--font-body); color: #51443a; margin: 0 0 8px; }
  .alge-faq-foot a { font-family: var(--font-body); font-weight: 700; color: #6f4315; }
</style>
</content>
</invoke>