---
---

<section class="alge-hero">
  <div class="alge-hero-bg">
    <picture>
      <source srcset="/img/algebehandling2.webp" type="image/webp" />
      <img src="/img/algebehandling2.jpeg" alt="Algebehandling af stråtag"
        fetchpriority="high" loading="eager" width="1920" height="1080" />
    </picture>
    <div class="alge-hero-overlay"></div>
  </div>

  <div class="alge-hero-content">
    <div class="alge-hero-text">
      <nav aria-label="Brødkrumme" class="alge-crumb">
        <a href="/">Forside</a>
        <span>›</span>
        <a href="/tagdaekning/">Tagdækning</a>
        <span>›</span>
        <span aria-current="page">Algebehandling</span>
      </nav>

      <span class="alge-eyebrow">Vedligeholdelse · Forlænget levetid</span>

      <h1 class="alge-h1">
        Algebehandling der <span class="alge-h1-italic">forlænger dit stråtags levetid</span> med 10–15 år
      </h1>

      <p class="alge-sub">
        Mos og alger er gift for et stråtag. Vi behandler dit tag med et godkendt, økologisk middel
        — fjerner mos, dræber svampesporer og forebygger genvækst. Inden for én arbejdsdag.
      </p>

      <div class="alge-pillars">
        <div class="alge-pillar">
          <div class="alge-pillar-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
          <div>
            <div class="alge-pillar-title">Økologisk middel</div>
            <div class="alge-pillar-meta">Ingen biocider eller klor</div>
          </div>
        </div>
        <div class="alge-pillar">
          <div class="alge-pillar-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
          <div>
            <div class="alge-pillar-title">+10–15 års levetid</div>
            <div class="alge-pillar-meta">Dokumenteret effekt</div>
          </div>
        </div>
        <div class="alge-pillar">
          <div class="alge-pillar-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
          <div>
            <div class="alge-pillar-title">Færdigt på en dag</div>
            <div class="alge-pillar-meta">Ingen lange byggepladser</div>
          </div>
        </div>
      </div>

      <div class="alge-cta">
        <a href="#kontakt" class="alge-btn-primary">Få fastpris på algebehandling</a>
        <a href="tel:+4524248080" class="alge-btn-phone">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Ring: 24 24 80 80
        </a>
      </div>

      <div class="alge-trust">
        <span>✓ Forsikret op til 12 mio. kr. hos Alm. Brand</span>
        <span>✓ 15+ års erfaring</span>
        <span>✓ CVR 44450976</span>
      </div>
    </div>
  </div>
</section>

<style>
  .alge-hero { position: relative; min-height: 100svh; padding-top: 96px; overflow: hidden; }
  .alge-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .alge-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 60% center; }
  .alge-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(251,249,248,0.97) 0%, rgba(251,249,248,0.92) 50%, rgba(251,249,248,0.45) 100%);
  }

  .alge-hero-content { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 56px 24px 80px; }
  .alge-hero-text { max-width: 760px; }

  .alge-crumb { display: flex; gap: 8px; align-items: center; font-family: var(--font-body); font-size: 0.85rem; color: #51443a; margin-bottom: 24px; }
  .alge-crumb a { color: #51443a; transition: color 0.3s; }
  .alge-crumb a:hover { color: #6f4315; }
  .alge-crumb span[aria-current] { color: #1b1c1c; font-weight: 700; }

  .alge-eyebrow { font-family: var(--font-label); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: #6f4315; display: block; margin-bottom: 16px; }

  .alge-h1 {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    color: #1b1c1c;
    margin: 0 0 24px;
    font-weight: 500;
  }
  .alge-h1-italic { font-style: italic; color: #6f4315; }

  .alge-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.65;
    color: #51443a;
    margin: 0 0 40px;
    max-width: 600px;
  }

  .alge-pillars { display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 32px; max-width: 720px; }
  .alge-pillar { display: flex; align-items: center; gap: 14px; padding: 16px; background: rgba(255,255,255,0.85); border: 1px solid rgba(111,67,21,0.15); border-radius: 12px; backdrop-filter: blur(4px); }
  .alge-pillar-check { flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: #6f4315; color: #fff; display: flex; align-items: center; justify-content: center; }
  .alge-pillar-title { font-family: var(--font-body); font-weight: 700; font-size: 1rem; color: #1b1c1c; line-height: 1.2; }
  .alge-pillar-meta { font-family: var(--font-body); font-size: 0.85rem; color: #51443a; }

  .alge-cta { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; }
  .alge-btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    background: #6f4315; color: #fff;
    padding: 18px 32px;
    font-family: var(--font-body); font-weight: 700;
    font-size: 1.05rem;
    border-radius: 10px;
    transition: transform 0.3s, background 0.3s;
    box-shadow: 0 8px 24px rgba(111,67,21,0.25);
  }
  .alge-btn-primary:hover { transform: translateY(-2px); background: #8b5a2b; }
  .alge-btn-phone {
    display: inline-flex; align-items: center; gap: 8px;
    color: #1b1c1c;
    padding: 18px 24px;
    font-family: var(--font-body); font-weight: 700;
    font-size: 1.05rem;
    border-radius: 10px;
    border: 1px solid rgba(27,28,28,0.2);
  }

  .alge-trust { display: flex; flex-wrap: wrap; gap: 16px; }
  .alge-trust span { font-family: var(--font-body); font-size: 0.85rem; color: #51443a; }

  @media (min-width: 640px) { .alge-pillars { grid-template-columns: repeat(3, 1fr); gap: 16px; } }
</style>
</content>
</invoke>