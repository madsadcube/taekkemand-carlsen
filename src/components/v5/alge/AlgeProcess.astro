---
const steps = [
  { n: '01', t: 'Inspektion', b: 'Vi kører ud, klatrer op og inspicerer taget — tager fotos af mos- og algeangreb, vurderer omfang og giver fastpris.' },
  { n: '02', t: 'Mekanisk fjernelse', b: 'Vi banker, børster og fjerner mos manuelt fra taget. Det er fysisk arbejde, men afgørende — middel virker ikke gennem mos-laget.' },
  { n: '03', t: 'Eftersyn & småreparationer', b: 'Mens vi er deroppe, efterser vi taget for huller, løse strå og skader på mønningen. Småreparationer er typisk inkluderet i prisen.' },
  { n: '04', t: 'Påsprøjtning af middel', b: 'Vi sprøjter med et godkendt, økologisk middel der dræber alle alge- og svampesporer — også dem du ikke kan se. Forebygger genvækst i flere år.' },
  { n: '05', t: 'Aflevering & tilsyn', b: 'Du får en kort gennemgang og en plan for tilsyn. Vi anbefaler tilsyn hvert 2.–3. år, så du kan få behandlet i tide næste gang.' },
]
---

<section class="alge-process">
  <div class="alge-process-container">
    <div class="alge-process-head">
      <span class="alge-eyebrow">Sådan kører det</span>
      <h2 class="alge-h2">
        Fra inspektion til <span class="alge-h2-italic">færdigbehandlet tag</span> — på én dag.
      </h2>
      <p class="alge-process-sub">
        Vi behandler typisk et tag på 4–6 timer afhængigt af størrelse og angrebsgrad.
        Du behøver ikke være hjemme — vi giver besked når vi er færdige.
      </p>
    </div>

    <div class="alge-process-timeline">
      {steps.map((s) => (
        <div class="alge-process-step">
          <div class="alge-process-circle">{s.n}</div>
          <div class="alge-process-card">
            <h3 class="alge-process-title">{s.t}</h3>
            <p class="alge-process-body">{s.b}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .alge-process { background: #fbf9f8; padding: 96px 0; }
  .alge-process-container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .alge-process-head { text-align: center; max-width: 720px; margin: 0 auto 56px; }
  .alge-eyebrow { font-family: var(--font-label); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: #6f4315; display: block; margin-bottom: 16px; }
  .alge-h2 { font-family: var(--font-headline); font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.2; color: #1b1c1c; margin: 0 0 16px; font-weight: 500; }
  .alge-h2-italic { font-style: italic; color: #6f4315; }
  .alge-process-sub { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.7; color: #51443a; }

  .alge-process-timeline { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .alge-process-step { display: grid; grid-template-columns: 64px 1fr; gap: 20px; align-items: start; position: relative; }
  .alge-process-step:not(:last-child)::after {
    content: '';
    position: absolute; left: 31px; top: 64px; bottom: -16px;
    width: 2px; background: rgba(111,67,21,0.2);
  }
  .alge-process-circle {
    width: 64px; height: 64px; border-radius: 50%;
    background: #6f4315; color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-headline); font-style: italic; font-size: 1.5rem;
    box-shadow: 0 8px 24px rgba(111,67,21,0.25);
  }
  .alge-process-card { background: #fff; padding: 20px 24px; border-radius: 12px; border: 1px solid rgba(111,67,21,0.12); box-shadow: 0 4px 16px rgba(0,0,0,0.04); }
  .alge-process-title { font-family: var(--font-body); font-weight: 700; font-size: 1.1rem; color: #1b1c1c; margin: 0 0 8px; }
  .alge-process-body { font-family: var(--font-body); font-size: 0.95rem; line-height: 1.65; color: #51443a; margin: 0; }
</style>
</content>
</invoke>