---
// V5 Hero — Trust-first, lys baggrund, social proof + 3 tillidssøjler + fastpris-fokus
---

<section class="v5-hero">
  <div class="v5-hero-bg">
    <picture>
      <source srcset="/img/straatag1-hero.webp" type="image/webp" />
      <img src="/img/straatag1-hero.jpg" alt="Stråtag af Tækkemand Carlsen"
        fetchpriority="high" loading="eager" width="1920" height="1080" />
    </picture>
    <div class="v5-hero-overlay"></div>
  </div>

  <div class="v5-hero-content">
    <div class="v5-hero-text">
      <div class="v5-hero-rating">
        <span class="v5-rating-text">Tækkefirma med <strong>15+ års erfaring</strong> · Primært Sjælland</span>
      </div>

      <h1 class="v5-h1">
        Nyt stråtag på Sjælland — <span class="v5-h1-italic">leveret inden 90 dage</span>
      </h1>

      <p class="v5-sub">
        Få et uforpligtende tilbud på nyt stråtag, mønning, reparation eller algebehandling. Vi servicerer primært private kunder på Sjælland.
      </p>

      <div class="v5-pillars">
        <div class="v5-pillar">
          <svg class="v5-pillar-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <div class="v5-pillar-body">
            <span class="v5-pillar-title">90 dage</span>
            <span class="v5-pillar-meta">Garanteret levering</span>
          </div>
        </div>
        <div class="v5-pillar">
          <svg class="v5-pillar-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <div class="v5-pillar-body">
            <span class="v5-pillar-title">15+ år</span>
            <span class="v5-pillar-meta">Tækkeerfaring</span>
          </div>
        </div>
        <div class="v5-pillar">
          <svg class="v5-pillar-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <div class="v5-pillar-body">
            <span class="v5-pillar-title">12 mio. kr</span>
            <span class="v5-pillar-meta">Forsikret hos Alm. Brand</span>
          </div>
        </div>
      </div>

      <div class="v5-cta">
        <a href="#kontakt" class="v5-btn-primary">Få fastpris på dit projekt</a>
        <a href="tel:+4524248080" class="v5-btn-phone">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Ring: 24 24 80 80
        </a>
      </div>

      <div class="v5-trust-row">
        <span class="v5-trust-item">✓ Forsikret op til 12 mio. kr.</span>
        <span class="v5-trust-item">✓ Primært Sjælland</span>
        <span class="v5-trust-item">✓ Uforpligtende tilbud</span>
      </div>
    </div>
  </div>
</section>

<style>
  .v5-hero { position: relative; min-height: 72vh; padding-top: 96px; overflow: hidden; }
  .v5-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .v5-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 60% center; }
  .v5-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(251,249,248,0.97) 0%, rgba(251,249,248,0.92) 50%, rgba(251,249,248,0.45) 100%);
  }

  .v5-hero-content {
    position: relative; z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 40px 24px 56px;
  }
  .v5-hero-text { max-width: 760px; }

  .v5-hero-rating { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 32px; }
  .v5-stars { display: flex; gap: 2px; color: #d4a017; }
  .v5-rating-num { font-family: var(--font-body); font-weight: 700; color: #1b1c1c; font-size: 0.95rem; }
  .v5-rating-divider { width: 4px; height: 4px; border-radius: 50%; background: #6f4315; }
  .v5-rating-text { font-family: var(--font-body); font-size: 0.9rem; color: #51443a; }

  .v5-h1 {
    font-family: var(--font-headline);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    color: #1b1c1c;
    margin: 0 0 24px;
    font-weight: 500;
  }
  .v5-h1-italic { font-style: italic; color: #6f4315; }

  .v5-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: #51443a;
    margin: 0 0 40px;
    max-width: 600px;
  }

  .v5-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 28px;
    margin-bottom: 28px;
    max-width: 720px;
  }
  .v5-pillar {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .v5-pillar-check {
    flex-shrink: 0;
    color: #6f4315;
  }
  .v5-pillar-body { display: flex; flex-direction: column; line-height: 1.2; }
  .v5-pillar-title { font-family: var(--font-body); font-weight: 700; font-size: 0.92rem; color: #1b1c1c; }
  .v5-pillar-meta { font-family: var(--font-body); font-size: 0.78rem; color: #6b5a4d; }

  .v5-cta { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; }
  .v5-btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    background: #6f4315; color: #fff;
    padding: 18px 32px;
    font-family: var(--font-body); font-weight: 700;
    font-size: 1.05rem;
    border-radius: 10px;
    transition: transform 0.3s, background 0.3s;
    box-shadow: 0 8px 24px rgba(111,67,21,0.25);
  }
  .v5-btn-primary:hover { transform: translateY(-2px); background: #8b5a2b; }
  .v5-btn-phone {
    display: inline-flex; align-items: center; gap: 10px;
    color: #1b1c1c;
    padding: 18px 28px;
    font-family: var(--font-body); font-weight: 700;
    font-size: 1.05rem;
    border-radius: 10px;
    background: #fbf9f8;
    border: 2px solid #1b1c1c;
    transition: transform 0.3s, background 0.3s, color 0.3s;
  }
  .v5-btn-phone:hover { transform: translateY(-2px); background: #1b1c1c; color: #fff; }
  .v5-btn-phone svg { color: #6f4315; transition: color 0.3s; }
  .v5-btn-phone:hover svg { color: #ffdcc1; }

  .v5-trust-row { display: flex; flex-wrap: wrap; gap: 16px; }
  .v5-trust-item { font-family: var(--font-body); font-size: 0.85rem; color: #51443a; }
</style>
</content>
</invoke>