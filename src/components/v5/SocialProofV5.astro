---
// V5 Social proof bar — under hero. Kun verificerede tal fra eksisterende site.
---

<section class="v5-proof" aria-label="Sociale beviser">
  <div class="v5-proof-container">
    <div class="v5-proof-stat">
      <div class="v5-proof-num">15+ år</div>
      <div class="v5-proof-label">Tækkeerfaring</div>
    </div>
    <div class="v5-proof-divider"></div>
    <div class="v5-proof-stat">
      <div class="v5-proof-num">90 dage</div>
      <div class="v5-proof-label">Garanteret leveringstid</div>
    </div>
    <div class="v5-proof-divider"></div>
    <div class="v5-proof-stat">
      <div class="v5-proof-num">12 mio. kr</div>
      <div class="v5-proof-label">Forsikret hos Alm. Brand</div>
    </div>
    <div class="v5-proof-divider"></div>
    <div class="v5-proof-stat">
      <div class="v5-proof-num">Sjælland</div>
      <div class="v5-proof-label">Vores primære område</div>
    </div>
  </div>
</section>

<style>
  .v5-proof {
    background: #1b1c1c;
    color: #fff;
    padding: 32px 0;
  }
  .v5-proof-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-around;
    gap: 24px;
  }
  .v5-proof-stat { text-align: center; min-width: 140px; }
  .v5-proof-num { font-family: var(--font-headline); font-size: 1.75rem; color: #ffdcc1; line-height: 1; font-weight: 500; }
  .v5-proof-label { font-family: var(--font-label); font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: rgba(255,255,255,0.7); margin-top: 6px; }
  .v5-proof-divider { width: 1px; height: 36px; background: rgba(255,220,193,0.2); display: none; }
  @media (min-width: 1024px) { .v5-proof-divider { display: block; } }
</style>
