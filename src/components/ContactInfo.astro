---
---

<section class="py-16" style="background: var(--color-surface-container-low); border-top: 1px solid var(--color-outline-variant);">
  <div class="max-w-4xl mx-auto px-8">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

      <!-- Telefon -->
      <a href="tel:+4524248080" class="flex items-start gap-4 p-5 rounded-xl transition-opacity hover:opacity-80" style="background: #fff; border: 1px solid var(--color-outline-variant);">
        <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background: var(--color-primary-fixed);">
          <svg class="w-5 h-5" fill="none" stroke="#6f4315" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider mb-1" style="color: var(--color-outline); font-family: var(--font-label);">Telefon</p>
          <p class="font-bold" style="color: #431a06; font-family: var(--font-body);">24 24 80 80</p>
        </div>
      </a>

      <!-- Email -->
      <a href="mailto:post@taekkemandcarlsen.dk" class="flex items-start gap-4 p-5 rounded-xl transition-opacity hover:opacity-80" style="background: #fff; border: 1px solid var(--color-outline-variant);">
        <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background: var(--color-primary-fixed);">
          <svg class="w-5 h-5" fill="none" stroke="#6f4315" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider mb-1" style="color: var(--color-outline); font-family: var(--font-label);">Email</p>
          <p class="font-bold" style="color: #431a06; font-family: var(--font-body); word-break: break-all;">post@taekkemandcarlsen.dk</p>
        </div>
      </a>

      <!-- Adresse -->
      <a href="https://maps.google.com/?q=Nørretorv+30,+4100+Ringsted" target="_blank" rel="noopener" class="flex items-start gap-4 p-5 rounded-xl transition-opacity hover:opacity-80" style="background: #fff; border: 1px solid var(--color-outline-variant);">
        <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background: var(--color-primary-fixed);">
          <svg class="w-5 h-5" fill="none" stroke="#6f4315" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider mb-1" style="color: var(--color-outline); font-family: var(--font-label);">Adresse</p>
          <p class="font-bold" style="color: #431a06; font-family: var(--font-body);">Nørretorv 30<br/>4100 Ringsted</p>
        </div>
      </a>

      <!-- Åbningstider -->
      <div class="flex items-start gap-4 p-5 rounded-xl" style="background: #fff; border: 1px solid var(--color-outline-variant);">
        <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background: var(--color-primary-fixed);">
          <svg class="w-5 h-5" fill="none" stroke="#6f4315" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider mb-1" style="color: var(--color-outline); font-family: var(--font-label);">Åbningstider</p>
          <p class="font-bold" style="color: #431a06; font-family: var(--font-body);">Hverdage<br/>08:00 – 16:00</p>
        </div>
      </div>

    </div>
  </div>
</section>
