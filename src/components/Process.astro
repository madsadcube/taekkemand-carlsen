---
const trin = [
  {
    nr: '01',
    titel: 'Gratis besigtigelse',
    tekst: 'Vi kigger altid forbi for at se opgaven med egne øjne. Gratis og uforpligtende — ingen overraskelser bagefter.',
  },
  {
    nr: '02',
    titel: 'Fast tilbud',
    tekst: 'Du får et gennemskueligt og ærligt prisoverslag gennemsnitligt inden for 48 timer, så du hurtigt kan komme videre.',
  },
  {
    nr: '03',
    titel: 'Professionel udførelse',
    tekst: 'Nyt stråtag, renovering, tagdækning, mønning og udskiftning af rygtræer — med fokus på kvalitet og korrekt håndværk.',
  },
  {
    nr: '04',
    titel: 'Garanti & aflevering',
    tekst: 'Du betaler først, når arbejdet er fuldført og godkendt. Vi afleverer arbejdet rent, ryddigt og som aftalt.',
  },
]
---

<section class="py-24" style="background: linear-gradient(180deg, #ffffff 0%, rgba(235,207,162,0.14) 65%, rgba(255,255,255,0.98) 100%); position: relative; overflow: hidden;">
  <div class="max-w-7xl mx-auto px-8">

    <!-- Top: headline + CTA -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-20">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-primary); font-family: var(--font-label); letter-spacing: 0.3em;">Strå på Sjælland</span>
        <h2 class="mt-4 leading-tight" style="font-family: var(--font-headline); font-size: clamp(2rem, 4vw, 3.2rem); color: #431a06;">
          Professionelt strå. Smukke resultater. Hurtigt udført.
        </h2>
      </div>
      <div>
        <p class="mb-8 leading-relaxed" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
          Vi er specialister i strå og har udført hundredvis af projekter på Sjælland. Med vores erfaring og de rette materialer sikrer vi et resultat, der holder i årtier.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#kontakt"
            class="px-7 py-3.5 rounded-lg font-bold text-center transition-opacity hover:opacity-90"
            style="background: var(--color-primary); color: #fff; font-family: var(--font-body);"
          >
            Hent et tilbud
          </a>
          <a
            href="tel:+4524248080"
            class="flex items-center gap-3 px-7 py-3.5 rounded-lg font-bold transition-all hover:bg-surface-container"
            style="border: 1.5px solid var(--color-outline-variant); color: var(--color-primary); font-family: var(--font-body);"
          >
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            24 24 80 80
          </a>
        </div>
      </div>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {trin.map((t) => (
        <div class="p-8 rounded-lg relative" style="background: var(--color-surface-container-low); border: 1px solid var(--color-outline-variant);">
          <span class="block text-5xl font-bold mb-4 leading-none" style="font-family: var(--font-headline); color: rgba(111,67,21,0.12);">{t.nr}</span>
          <h3 class="mb-3" style="font-family: var(--font-headline); font-size: 1.15rem; color: #431a06;">{t.titel}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--color-outline); font-family: var(--font-body);">{t.tekst}</p>
        </div>
      ))}
    </div>

    <!-- Trust badge -->
    <div class="flex items-center justify-center gap-4 py-6 px-8 rounded-lg" style="background: var(--color-surface-container-low); border: 1px solid var(--color-outline-variant);">
      <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: var(--color-primary);"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      <p class="text-sm font-medium" style="color: var(--color-on-surface-variant); font-family: var(--font-body);">
        Vi er forsikret med op til <strong style="color: #431a06;">12 millioner kroner</strong> i dækning — for din tryghed.
      </p>
    </div>

  </div>
</section>
