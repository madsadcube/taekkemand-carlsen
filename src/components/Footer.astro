---
---

<footer class="bg-dark-2 text-gray-400 pt-14 pb-8 border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-4 gap-10 mb-10">
      <!-- Brand -->
      <div class="md:col-span-2">
        <img
          src="/img/logo-light.webp"
          alt="Tækkemand Carlsen"
          width="140"
          height="50"
          loading="lazy"
          class="h-10 w-auto mb-4"
        />
        <p class="text-sm leading-relaxed mb-5">
          Professionel tækkemand i Ringsted med speciale i stråtag, tagrenovering og vedligehold. Vi betjener hele Sjælland med 15+ års erfaring.
        </p>
        <div class="flex gap-3">
          <a href="https://www.facebook.com/taekkemandcarlsen" target="_blank" rel="noopener" aria-label="Facebook"
            class="w-9 h-9 bg-gray-700 hover:bg-primary rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/taekkemandcarlsen" target="_blank" rel="noopener" aria-label="Instagram"
            class="w-9 h-9 bg-gray-700 hover:bg-primary rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-white font-bold mb-4">Vores services</h4>
        <ul class="space-y-2 text-sm">
          {[
            ['Reparation af stråtag', '/reparation-straatag'],
            ['Algebehandling', '/algebehandling'],
            ['Vedligehold', '/vedligehold-straatag'],
            ['Mønning', '/reparation-monning'],
            ['Skorsten', '/skorstensrenovering'],
            ['Vinduespolering', '/#ejendomsservice'],
          ].map(([label, href]) => (
            <li>
              <a href={href} class="hover:text-primary transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Kontakt -->
      <div>
        <h4 class="text-white font-bold mb-4">Kontakt</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="tel:+4589883453" class="hover:text-primary transition-colors flex items-center gap-2">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              89 88 34 53
            </a>
          </li>
          <li>
            <a href="mailto:post@taekkemandcarlsen.dk" class="hover:text-primary transition-colors flex items-center gap-2">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              post@taekkemandcarlsen.dk
            </a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Nørretorv 30, 4100 Ringsted
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Man–Fre: 08:00–18:00
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-sm">
      <p>&copy; {new Date().getFullYear()} Tækkemand Carlsen ApS — CVR: Nørretorv 30, 4100 Ringsted</p>
      <p>Bygget med ❤ af <a href="https://synlii.dk" class="text-primary hover:underline">Synlii</a></p>
    </div>
  </div>
</footer>
