---
---

<nav class="fixed top-0 w-full z-50" style="background: rgba(251,249,248,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(213,195,182,0.3);">
  <div class="flex justify-between items-center max-w-7xl mx-auto px-8 py-5">
    <a href="/">
      <img src="/img/logo-dark.png" alt="Tækkemand Carlsen" class="h-10 w-auto" width="200" height="60" decoding="async" />
    </a>

    <div class="hidden md:flex items-center gap-8 text-lg" style="font-family: var(--font-headline); font-style: italic;">
      <a class="transition-colors duration-300" style="color: #51443a;" href="#saadan-arbejder-vi"
        onmouseover="this.style.color='#6f4315'" onmouseout="this.style.color='#51443a'">Services</a>
      <a class="transition-colors duration-300" style="color: #51443a;" href="#billeder"
        onmouseover="this.style.color='#6f4315'" onmouseout="this.style.color='#51443a'">Projekter</a>
      <a class="transition-colors duration-300" style="color: #51443a;" href="#anmeldelser"
        onmouseover="this.style.color='#6f4315'" onmouseout="this.style.color='#51443a'">Om os</a>
      <a class="transition-colors duration-300" style="color: #51443a;" href="#kontakt"
        onmouseover="this.style.color='#6f4315'" onmouseout="this.style.color='#51443a'">Kontakt</a>
    </div>

    <a
      href="tel:+4589883453"
      class="hidden md:flex items-center gap-2 px-6 py-2 rounded-lg font-bold transition-all"
      style="background: #6f4315; color: #fff; font-family: var(--font-body); font-size: 1rem;"
      onmouseover="this.style.background='#8b5a2b'" onmouseout="this.style.background='#6f4315'"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
      89 88 34 53
    </a>

    <!-- Hamburger -->
    <button id="menu-btn" class="md:hidden p-2" aria-label="Menu">
      <svg class="w-6 h-6" style="color:#1b1c1c" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        <path id="icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden px-8 pb-6 space-y-4" style="border-top: 1px solid rgba(213,195,182,0.4);">
    <a href="#saadan-arbejder-vi" class="block py-2 text-on-surface-variant hover:text-primary transition-colors" style="font-family: var(--font-headline); font-style: italic; font-size: 1.1rem;">Services</a>
    <a href="#billeder" class="block py-2 text-on-surface-variant hover:text-primary transition-colors" style="font-family: var(--font-headline); font-style: italic; font-size: 1.1rem;">Projekter</a>
    <a href="#anmeldelser" class="block py-2 text-on-surface-variant hover:text-primary transition-colors" style="font-family: var(--font-headline); font-style: italic; font-size: 1.1rem;">Om os</a>
    <a href="#kontakt" class="block text-center py-3 px-6 rounded-lg font-bold text-sm uppercase tracking-widest" style="background: #6f4315; color: #fff; font-family: var(--font-label);">Få et Tilbud</a>
  </div>
</nav>

<script>
  const btn = document.getElementById('menu-btn')!
  const menu = document.getElementById('mobile-menu')!
  const open = document.getElementById('icon-open')!
  const close = document.getElementById('icon-close')!
  btn.addEventListener('click', () => {
    const hidden = menu.classList.toggle('hidden')
    open.classList.toggle('hidden', !hidden)
    close.classList.toggle('hidden', hidden)
  })
</script>
