---
// V8 Services — fire kapitler/kort i journal-stil
const services = [
  { num: '02', name: 'Nyt stråtag', desc: 'Komplet ny tækning fra spær til mønning. 60–80 års levetid med rette pleje.', img: '/img/straatag1.jpg', href: '/tagdaekning/nyt-straatag/' },
  { num: '03', name: 'Renovering & reparation', desc: 'Lokal udskiftning, akut reparation efter storm, eller fuld renovering af ældre tag.', img: '/img/rep_straatag4.jpeg', href: '/tagdaekning/renovering-af-straatag/' },
  { num: '04', name: 'Mønning', desc: 'Den øverste tagryg bundet i halmlæg. Uden god mønning løber resten ikke længe.', img: '/img/rygning.jpg', href: '/tagdaekning/monning-til-straatag/' },
  { num: '05', name: 'Algebehandling', desc: 'Økologisk behandling der forlænger taglevetiden med 10–15 år. Ingen kemikalier på taget.', img: '/img/algebehandling2.jpeg', href: '/tagdaekning/aldebehandling-af-straatag/' },
]
---

<section class="v8-services" id="ydelser">
  <div class="v8-services-head">
    <div class="v8-chapter">
      <div class="v8-chapter-num">Kap. 02</div>
      <div class="v8-chapter-title">Håndværket</div>
    </div>
    <h2 class="v8-h2-center">
      Fire ting vi gør — <em>og gør grundigt.</em>
    </h2>
    <p class="v8-services-sub">
      Vi laver kun stråtag. Det betyder at vi har lavet hver eneste detalje
      tusind gange — og kender de fælder, en generalist løber ind i.
    </p>
  </div>

  <div class="v8-services-grid">
    {services.map((s, i) => (
      <a href={s.href} class={`v8-service-card v8-card-${i + 1}`}>
        <figure class="v8-service-photo">
          <img src={s.img} alt={s.name} loading="lazy"/>
        </figure>
        <div class="v8-service-text">
          <div class="v8-service-num">№{s.num}</div>
          <h3 class="v8-service-name">{s.name}</h3>
          <p class="v8-service-desc">{s.desc}</p>
          <span class="v8-service-link">Læs mere →</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .v8-services { background: #faf5eb; padding: 96px 0; position: relative; }
  .v8-services-head { max-width: 720px; margin: 0 auto 56px; padding: 0 24px; text-align: center; }
  .v8-chapter { display: inline-flex; align-items: baseline; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid rgba(111,67,21,0.2); margin-bottom: 24px; }
  .v8-chapter-num { font-family: var(--font-label); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: #6f4315; }
  .v8-chapter-title { font-family: var(--font-headline); font-style: italic; font-size: 1.25rem; color: #1b1c1c; }
  .v8-h2-center { font-family: var(--font-headline); font-size: clamp(1.75rem, 4.5vw, 2.75rem); line-height: 1.15; color: #1b1c1c; margin: 0 0 16px; font-weight: 500; }
  .v8-h2-center em { font-style: italic; color: #6f4315; font-weight: 400; }
  .v8-services-sub { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.7; color: #51443a; max-width: 560px; margin: 0 auto; }

  .v8-services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .v8-service-card {
    background: #fff;
    padding: 16px 16px 32px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
    display: block;
    transition: transform 0.4s, box-shadow 0.4s;
    text-decoration: none;
    color: inherit;
  }
  .v8-service-card:hover { transform: translateY(-4px) rotate(0deg) !important; box-shadow: 0 24px 48px rgba(0,0,0,0.18); }
  .v8-card-1 { transform: rotate(-1.5deg); }
  .v8-card-2 { transform: rotate(1.5deg); }
  .v8-card-3 { transform: rotate(-1deg); }
  .v8-card-4 { transform: rotate(2deg); }

  .v8-service-photo {
    margin: 0 0 20px;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #f4ede2;
  }
  .v8-service-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
  .v8-service-card:hover .v8-service-photo img { transform: scale(1.05); }

  .v8-service-text { padding: 0 8px; }
  .v8-service-num { font-family: var(--font-label); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: #6f4315; margin-bottom: 6px; }
  .v8-service-name { font-family: var(--font-headline); font-size: 1.5rem; font-style: italic; color: #1b1c1c; margin: 0 0 12px; line-height: 1.2; }
  .v8-service-desc { font-family: var(--font-body); font-size: 0.95rem; line-height: 1.6; color: #51443a; margin: 0 0 16px; }
  .v8-service-link { font-family: var(--font-body); font-weight: 700; font-size: 0.9rem; color: #1b1c1c; border-bottom: 1px solid #1b1c1c; padding-bottom: 2px; }

  @media (min-width: 768px) {
    .v8-services-grid { grid-template-columns: repeat(2, 1fr); gap: 48px; }
  }
  @media (min-width: 1024px) {
    .v8-services-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
</content>
</invoke>