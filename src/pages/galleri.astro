---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Gallery from '../components/Gallery.astro'
import Testimonials from '../components/Testimonials.astro'
import Contact from '../components/Contact.astro'
import Footer from '../components/Footer.astro'
---

<Layout
  title="Galleri | Stråtag & tækkearbejde — Tækkemand Carlsen"
  description="Se eksempler på vores stråtagsarbejde fra Nordsjælland. Nyt stråtag, mønning, reparation og renovering — billeder fra rigtige projekter."
  canonical="https://taekkemandcarlsen.dk/galleri/"
>
  <Nav />
  <div class="pt-32 pb-16 px-8 max-w-4xl mx-auto text-center" style="background: #faf6f1;">
    <p style="font-family: var(--font-headline); font-style: italic; color: #6f4315; font-size: 1rem; letter-spacing: 0.05em;">Vores arbejde</p>
    <h1 class="text-5xl md:text-6xl mt-3" style="font-family: var(--font-headline); color: #1b1c1c;">Galleri</h1>
    <p class="mt-4 text-lg" style="color: #51443a; font-family: var(--font-body);">Billeder fra stråtag, mønning og renoveringer over hele Sjælland.</p>
  </div>
  <Gallery />
  <Testimonials />
  <Contact />
  <Footer />
</Layout>
