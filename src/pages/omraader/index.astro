---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Contact from '../../components/Contact.astro'
import Footer from '../../components/Footer.astro'
import { cities } from '../../data/cities'

// Gruppér efter region
const byRegion = cities.reduce((acc, c) => {
  if (!acc[c.region]) acc[c.region] = []
  acc[c.region].push(c)
  return acc
}, {} as Record<string, typeof cities>)

// Sorter byer alfabetisk inden for hver region
Object.values(byRegion).forEach(arr => arr.sort((a, b) => a.name.localeCompare(b.name, 'da')))

const regionOrder = ['Nordsjælland', 'Midtsjælland', 'Sydsjælland']
---

<Layout
  title="Områder vi dækker | Tækkemand Carlsen på Sjælland"
  description="Tækkemand Carlsen servicerer primært private kunder på Sjælland. Se de byer og områder hvor vi udfører stråtag, mønning og reparation."
  canonical="https://taekkemandcarlsen.dk/omraader/"
>
  <Nav />
  <div class="pt-32 pb-16 px-8 max-w-4xl mx-auto text-center" style="background: #faf6f1;">
    <p style="font-family: var(--font-headline); font-style: italic; color: #6f4315; font-size: 1rem; letter-spacing: 0.05em;">Primært Sjælland</p>
    <h1 class="text-5xl md:text-6xl mt-3" style="font-family: var(--font-headline); color: #1b1c1c;">Områder vi dækker</h1>
    <p class="mt-4 text-lg" style="color: #51443a; font-family: var(--font-body);">Tækkemand Carlsen servicerer primært private kunder på Sjælland. Find dit område nedenfor.</p>
  </div>

  <section class="py-16 px-8" style="background: #fbf9f8;">
    <div class="max-w-6xl mx-auto space-y-12">
      {regionOrder.filter(r => byRegion[r]).map(region => (
        <div>
          <h2 class="text-3xl mb-6" style="font-family: var(--font-headline); color: #6f4315; font-style: italic;">{region}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {byRegion[region].map(city => (
              <a
                href={`/${city.slug}/`}
                class="block p-6 rounded-lg transition-all hover:shadow-md"
                style="background: #fff; border: 1px solid rgba(213,195,182,0.4);"
              >
                <h3 class="text-xl mb-2" style="font-family: var(--font-headline); color: #1b1c1c;">{city.name}</h3>
                <p class="text-sm" style="color: #51443a; font-family: var(--font-body);">{city.description}</p>
                <span class="inline-block mt-3 text-sm font-semibold" style="color: #6f4315; font-family: var(--font-body);">Se område →</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <Contact />
  <Footer />
</Layout>
